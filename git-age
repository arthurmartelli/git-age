RuleState = tuple[tuple[pathlib.PurePosixPath, str], ...]

# Backs up the refs `audit --rekey` rewrote, so that it can be undone.
ORIGINAL_REFS = "refs/git-age/original"
DELETE_ORIGINAL_REFS = (
    f"git for-each-ref --format='delete %(refname)' {ORIGINAL_REFS} | git update-ref --stdin"
)

# Remote-tracking refs are left out: they record what the remote has.
REWRITTEN_REF_PREFIXES = ("refs/heads/", "refs/tags/", "refs/stash")

TAG_SIGNATURE = re.compile(
    rb"^-----BEGIN (?:PGP SIGNATURE|PGP MESSAGE|SSH SIGNATURE|SIGNED MESSAGE)-----$", re.M
)


class ObjectReader:
    """Reads Git objects through one long-running `git cat-file --batch`."""

    def __init__(self, git: Git) -> None:
        self._process = subprocess.Popen(
            [_require_executable("git"), "-C", os.fspath(git.root), "cat-file", "--batch"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
        )

    def __enter__(self) -> ObjectReader:
        return self

    def __exit__(self, *_: object) -> None:
        assert self._process.stdin is not None
        self._process.stdin.close()
        self._process.wait()

    def read(self, oid: str) -> bytes:
        stdin, stdout = self._process.stdin, self._process.stdout
        assert stdin is not None and stdout is not None
        stdin.write(oid.encode("ascii") + b"\n")
        stdin.flush()
        header = stdout.readline().split()
        if len(header) != 3:
            raise RuntimeError(f"cannot read Git object {oid}")
        content = stdout.read(int(header[2]))
        stdout.read(1)
        return content


def _raw_log_records(
    output: bytes,
) -> Iterator[tuple[str, list[str], pathlib.PurePosixPath]]:
    """
    Parse `git log --format=%x00%H --raw -z --no-renames` into (commit,
    [old mode, new mode, old oid, new oid, status], path).
    """

    tokens = output.split(b"\0")
    commit = ""
    index = 0
    while index < len(tokens):
        token = tokens[index].lstrip(b"\n")
        index += 1
        if token.startswith(b":"):
            path = pathlib.PurePosixPath(os.fsdecode(tokens[index]))
            index += 1
            yield commit, token[1:].decode("ascii").split(" "), path
        elif token:
            commit = token.decode("ascii")


def _parse_tree(content: bytes, oid_length: int) -> list[tuple[bytes, bytes, str]]:
    """Parse a raw tree object into (mode, name, oid) entries."""

    entries = []
    position = 0
    while position < len(content):
        space = content.index(b" ", position)
        nul = content.index(b"\0", space)
        end = nul + 1 + oid_length
        mode, name, oid = content[position:space], content[space + 1 : nul], content[nul + 1 : end]
        entries.append((mode, name, oid.hex()))
        position = end
    return entries


def _split_object(content: bytes) -> tuple[list[bytes], bytes]:
    """The header lines and the message of a commit or tag object."""

    header, separator, message = content.partition(b"\n\n")
    if not separator:
        header = header.rstrip(b"\n")
    return header.split(b"\n"), message


def _without_signature(lines: list[bytes]) -> tuple[list[bytes], bool]:
    """Drop the gpgsig headers, with their continuation lines; and whether there were any."""

    kept: list[bytes] = []
    signed = in_signature = False
    for line in lines:
        if in_signature and line.startswith(b" "):
            continue
        in_signature = line.startswith((b"gpgsig ", b"gpgsig-sha256 "))
        signed |= in_signature
        if not in_signature:
            kept.append(line)
    return kept, signed


def _join_object(lines: list[bytes], message: bytes) -> bytes:
    return b"\n".join(lines) + b"\n\n" + message


def _describe_commit(reader: ObjectReader, commit: str) -> str:
    lines, message = _split_object(reader.read(commit))
    subject = message.split(b"\n", 1)[0].decode(errors="replace")
    return f"{commit[:12]}  {subject}"


class History:
    """
    The commits of some revisions and the .gitage rules in each; paths are
    relative to the Git root.

    A path counts as protected in a commit when the current .gitage files
    protect it or the commit's own did: a secret committed before its
    pattern was added leaked just the same. Without current_rules, only
    the commit's own count, e.g. when the working tree has no .gitage.
    """

    def __init__(self, git: Git, revisions: list[str], *, current_rules: bool = True) -> None:
        self.git = git
        self.revisions = revisions
        self.current = Repository.from_working_tree(git.root) if current_rules else None
        # Parents first, since a commit's rules start from its parent's.
        result = git.run(
            ["rev-list", "--topo-order", "--reverse", "--parents", *revisions, "--"],
            error="cannot list the commits to audit",
        )
        self.commits: list[str] = []
        self._first_parents: dict[str, str | None] = {}
        for line in result.stdout.decode("ascii").splitlines():
            commit, *parents = line.split()
            self.commits.append(commit)
            self._first_parents[commit] = parents[0] if parents else None
        self._states: dict[str, RuleState] = {}
        self._rules: dict[RuleState, Repository | None] = {}
        self._load_rule_states()

    def _log(self, args: list[str], *pathspecs: str) -> bytes:
        return self.git.run(
            [
                "log",
                "--root",
                "--raw",
                "-z",
                "--no-abbrev",
                "--no-renames",
                "--format=%x00%H",
                *args,
                *self.revisions,
                "--",
                *pathspecs,
            ],
            error="cannot read the history",
        ).stdout

    def _load_rule_states(self) -> None:
        """
        Track the .gitage files commit by commit: a commit has its first
        parent's, changed by its diff to that parent.
        """

        output = self._log(
            ["--full-history", "--diff-merges=first-parent"], f":(glob)**/{RULE_FILE_NAME}"
        )
        changes: dict[str, list[tuple[list[str], pathlib.PurePosixPath]]] = {}
        for commit, fields, path in _raw_log_records(output):
            if path.name == RULE_FILE_NAME:
                changes.setdefault(commit, []).append((fields, path))

        for commit in self.commits:
            parent = self._first_parents[commit]
            state = () if parent is None else self.rule_state(parent)
            if commit in changes:
                files = dict(state)
                for (_old_mode, mode, _old_oid, oid, status), path in changes[commit]:
                    if status == "D" or mode not in REGULAR_FILE_MODES:
                        files.pop(path, None)
                    else:
                        files[path] = oid
                state = tuple(sorted(files.items()))
            self._states[commit] = state

    def rule_state(self, commit: str) -> RuleState:
        state = self._states.get(commit)
        if state is None:
            # Outside the revisions, e.g. below a range: read its tree.
            state = self._states[commit] = tuple(
                sorted(
                    (path, oid)
                    for path, oid in self.git.tree(commit).items()
                    if path.name == RULE_FILE_NAME
                )
            )
        return state

    def rules_at(self, commit: str) -> Repository | None:
        """The rules in commit; None without .gitage files or when they do not parse."""

        state = self.rule_state(commit)
        if state not in self._rules:
            repository = None
            if state:
                try:
                    repository = Repository.from_blobs(self.git, state, commit[:12])
                except RuntimeError as exc:
                    _err(f"git-age: warning: {exc}; using only the current rules there")
            self._rules[state] = repository
        return self._rules[state]

    def protects(self, commit: str, path: pathlib.PurePosixPath) -> bool:
        if self.current is not None and self.current.protection(path) is not None:
            return True
        rules = self.rules_at(commit)
        return rules is not None and rules.protection(path) is not None

    def introduced(self) -> dict[tuple[pathlib.PurePosixPath, str], list[str]]:
        """
        Every regular-file blob a commit added or changed, by (path, oid),
        with the commits that did, oldest first. Merges count with what
        they changed against each parent, which includes conflict
        resolutions.
        """

        output = self._log(["--topo-order", "--reverse", "--diff-merges=separate"])
        introduced: dict[tuple[pathlib.PurePosixPath, str], list[str]] = {}
        for commit, (_old_mode, mode, _old_oid, oid, status), path in _raw_log_records(output):
            if status == "D" or mode not in REGULAR_FILE_MODES:
                continue
            commits = introduced.setdefault((path, oid), [])
            if commit not in commits:
                commits.append(commit)
        return introduced


class Leak(NamedTuple):
    """A blob that should not be in history: plaintext at a protected path, or a private key."""

    path: pathlib.PurePosixPath
    oid: str
    commits: list[str]


class Leaks(NamedTuple):
    """What `git-age audit` finds."""

    plaintext: list[Leak]
    keys: list[Leak]


def find_leaks(history: History, reader: ObjectReader) -> Leaks:
    """
    The plaintext blobs at protected paths, where empty files hide nothing,
    and the private keys. Every blob is read, but each only once.
    """

    leaks = Leaks([], [])
    blobs: dict[str, tuple[FileState | None, bool]] = {}
    marker = AGE_SECRET_KEY_MARKER.encode("ascii")
    for (path, oid), commits in sorted(history.introduced().items()):
        if oid not in blobs:
            content = reader.read(oid)
            state = detect_content_state(content) if content else None
            blobs[oid] = state, state is FileState.UNLOCKED and marker in content
        state, has_key = blobs[oid]
        if path.name == LOCAL_KEY_FILE_NAME or has_key:
            leaks.keys.append(Leak(path, oid, commits))
        protecting = [commit for commit in commits if history.protects(commit, path)]
        if protecting and state is FileState.UNLOCKED:
            leaks.plaintext.append(Leak(path, oid, protecting))
    return leaks


def _print_leak_group(
    config: Config, title: str, leaks: list[Leak], reader: ObjectReader
) -> dict[pathlib.PurePosixPath, list[Leak]]:
    """Print leaks by path, the first commit of the first version unless -v; and return them."""

    print(title)
    by_path: dict[pathlib.PurePosixPath, list[Leak]] = {}
    for leak in leaks:
        by_path.setdefault(leak.path, []).append(leak)

    for path, path_leaks in by_path.items():
        print(f"\n  {_quote_porcelain_path(path.as_posix())}")
        shown = path_leaks if config.options.verbose else path_leaks[:1]
        for leak in shown:
            commits = leak.commits if config.options.verbose else leak.commits[:1]
            for commit in commits:
                print(f"    {leak.oid[:12]} in {_describe_commit(reader, commit)}")
            if len(leak.commits) > len(commits):
                print(f"    {'':12}    and {len(leak.commits) - len(commits)} more commit(s)")
        if len(path_leaks) > len(shown):
            print(f"    and {len(path_leaks) - len(shown)} more version(s); -v lists them")
    return by_path


def _print_leaks(
    config: Config, leaks: Leaks, reader: ObjectReader, *, pushing: bool = False
) -> None:
    """
    Print what audit found, with advice; while pushing, the advice is to
    fix the commits before they leave, see _push_leak_advice().
    """

    where = "in the commits being pushed" if pushing else "in Git history"
    if leaks.keys:
        title = (
            "Private age keys in the commits being pushed:"
            if pushing
            else "Private age keys committed to Git history:"
        )
        by_path = _print_leak_group(config, title, leaks.keys, reader)
        _err(
            "",
            f"git-age: {len(leaks.keys)} version(s) of {len(by_path)} private key file(s) "
            f"are {where}.",
            *([] if pushing else _key_leak_advice()),
        )
    if leaks.keys and leaks.plaintext:
        print()
    if leaks.plaintext:
        by_path = _print_leak_group(
            config, "Protected files committed as plaintext:", leaks.plaintext, reader
        )
        _err(
            "",
            f"git-age: {len(leaks.plaintext)} plaintext version(s) of {len(by_path)} "
            f"protected file(s) are {where}.",
        )
        if not pushing:
            _err(
                "Anyone with a copy of the repository can read them, so change those secrets.",
                "Then encrypt them in history; this rewrites every commit:",
                "",
                "  git-age audit --rekey",
            )
    if pushing:
        _err(*_push_leak_advice())


def _push_leak_advice() -> list[str]:
    return [
        "",
        "Fix the commits before pushing them. For the last commit, encrypt the files",
        "(`git-age lock`) or drop the keys (`git rm --cached`), then:",
        "",
        "  git commit --amend",
        "",
        "For earlier ones, edit them with `git rebase -i`, or re-encrypt every local",
        "commit with `git-age audit --rekey`, which cannot remove keys. If these commits",
        "were pushed anywhere before, treat those secrets and keys as compromised;",
        "`git-age audit` explains what to do. To push anyway, run:",
        "",
        f"  {ALLOW_PLAINTEXT_PUSH_ENV}=1 git push ...",
        "",
    ]


def _key_leak_advice() -> list[str]:
    return [
        "Anyone with a copy of the repository has those keys, and can decrypt whatever",
        "was encrypted to them, in any copy of the history. Treat them as compromised:",
        "",
        "  1. generate a new key: git-age keygen -o /path/to/new.key",
        "  2. replace the old key's recipient in [recipients] with the new one",
        "  3. re-encrypt the files: git-age rekey; and history: git-age audit --rekey",
        "  4. change the secrets those files hold anyway",
        "",
        "`audit --rekey` does not remove the key files from history; purge them with",
        "a history rewriting tool such as git filter-repo.",
    ]


class HistoryRewrite:
    """
    Re-encrypt the protected files of every commit to the current
    recipients, for `git-age audit --rekey`. This only writes objects;
    apply() then moves the refs. Under --dry-run nothing is written and
    the new oids are made up.
    """

    def __init__(self, config: Config, history: History, reader: ObjectReader) -> None:
        self.config = config
        self.history = history
        self.git = history.git
        self.reader = reader
        options = config.options
        self.plaintext_only: bool = options.plaintext_only
        self.dry_run = config.options.dry_run
        self.oid_length = len(history.commits[0]) // 2 if history.commits else 20
        self.blobs: dict[tuple[str, tuple[str, ...]], str] = {}
        self.trees: dict[tuple[pathlib.PurePosixPath, str, RuleState], str] = {}
        self.commits: dict[str, str] = {}
        self.tags: dict[str, str] = {}
        self.undecryptable: dict[tuple[pathlib.PurePosixPath, str], str] = {}
        self.encrypted = 0
        self.reencrypted = 0
        self.signatures = 0

    def _write(self, kind: str, content: bytes) -> str:
        if self.dry_run:
            algorithm = "sha1" if self.oid_length == 20 else "sha256"
            return hashlib.new(algorithm, kind.encode() + b"\0" + content).hexdigest()
        return (
            self.git.run(
                ["hash-object", "-t", kind, "-w", "--stdin"],
                input_bytes=content,
                error=f"cannot write a Git {kind}",
            )
            .stdout.decode("ascii")
            .strip()
        )

    def _encrypt(self, age: Age, plaintext: bytes) -> str:
        return self._write("blob", plaintext if self.dry_run else age.encrypt(plaintext))

    def rewrite_blob(self, commit: str, path: pathlib.PurePosixPath, oid: str) -> str:
        age = self.config.age_for(self.git.absolute(path))
        key = (oid, tuple(age.encrypt_command()))
        if key in self.blobs:
            return self.blobs[key]

        new = oid
        content = self.reader.read(oid)
        if detect_content_state(content) is FileState.UNLOCKED:
            new = self._encrypt(age, content)
            self.encrypted += 1
        elif not self.plaintext_only:
            plaintext = age.decrypt(content)
            if plaintext is None:
                self.undecryptable.setdefault((path, oid), commit)
            else:
                new = self._encrypt(age, plaintext)
                self.reencrypted += 1
        self.blobs[key] = new
        return new

    def rewrite_tree(self, commit: str, prefix: pathlib.PurePosixPath, oid: str) -> str:
        key = (prefix, oid, self.history.rule_state(commit))
        if key in self.trees:
            return self.trees[key]

        changed = False
        content = bytearray()
        for mode, name, entry_oid in _parse_tree(self.reader.read(oid), self.oid_length):
            path = prefix / os.fsdecode(name)
            new = entry_oid
            if mode == b"40000":
                new = self.rewrite_tree(commit, path, entry_oid)
            elif mode.decode() in REGULAR_FILE_MODES and self.history.protects(commit, path):
                new = self.rewrite_blob(commit, path, entry_oid)
            changed |= new != entry_oid
            content += mode + b" " + name + b"\0" + bytes.fromhex(new)

        self.trees[key] = self._write("tree", bytes(content)) if changed else oid
        return self.trees[key]

    def rewrite_commit(self, commit: str) -> None:
        """Rewrite commit, whose parents are rewritten already. Unchanged ones keep their oid."""

        lines, message = _split_object(self.reader.read(commit))
        tree = lines[0][5:].decode("ascii")
        parents = [line[7:].decode("ascii") for line in lines if line.startswith(b"parent ")]
        new_tree = self.rewrite_tree(commit, pathlib.PurePosixPath(), tree)
        new_parents = [self.commits.get(parent, parent) for parent in parents]
        if new_tree == tree and new_parents == parents:
            self.commits[commit] = commit
            return

        rest, signed = _without_signature(
            [line for line in lines[1:] if not line.startswith(b"parent ")]
        )
        self.signatures += signed
        header = [
            b"tree " + new_tree.encode(),
            *(b"parent " + parent.encode() for parent in new_parents),
            *rest,
        ]
        self.commits[commit] = self._write("commit", _join_object(header, message))

    def rewrite_tag(self, tag: str) -> str:
        """An annotated tag pointing to the rewritten object, without its signature."""

        if tag in self.tags:
            return self.tags[tag]
        lines, message = _split_object(self.reader.read(tag))
        target = lines[0][7:].decode("ascii")
        kind = lines[1][5:]
        new_target = target
        if kind == b"commit":
            new_target = self.commits.get(target, target)
        elif kind == b"tag":
            new_target = self.rewrite_tag(target)

        new = tag
        if new_target != target:
            rest, signed = _without_signature(lines[1:])
            signature = TAG_SIGNATURE.search(message)
            if signature is not None:
                message = message[: signature.start()]
            self.signatures += signed or signature is not None
            header = [b"object " + new_target.encode(), *rest]
            new = self._write("tag", _join_object(header, message))
        self.tags[tag] = new
        return new

    def run(self, refs: list[tuple[str, str, str]]) -> list[tuple[str, str, str]]:
        """Rewrite every commit; returns (ref, old, new) for each ref that moves."""

        for commit in self.history.commits:
            self.rewrite_commit(commit)

        moves = []
        for ref, oid, kind in refs:
            new = self.rewrite_tag(oid) if kind == "tag" else self.commits.get(oid, oid)
            if new != oid:
                moves.append((ref, oid, new))
        return moves


def _rewritable_refs(git: Git) -> list[tuple[str, str, str]]:
    """The refs `audit --rekey` rewrites, as (ref, oid, object type); HEAD when detached."""

    result = git.run(["for-each-ref", "--format=%(refname)%00%(objectname)%00%(objecttype)"])
    candidates = [line.split("\0") for line in os.fsdecode(result.stdout).splitlines()]
    candidates = [entry for entry in candidates if entry[0].startswith(REWRITTEN_REF_PREFIXES)]
    # Peeled here, since older Git peels only one level with %(*objecttype).
    tags = [oid for _, oid, kind in candidates if kind == "tag"]
    peeled: dict[str, str] = {}
    if tags:
        result = git.run(
            ["cat-file", "--batch-check=%(objecttype)"],
            input_bytes="".join(f"{oid}^{{}}\n" for oid in tags).encode("ascii"),
        )
        peeled = dict(zip(tags, result.stdout.decode("ascii").splitlines()))
    refs = []
    for ref, oid, kind in candidates:
        if kind == "commit" or peeled.get(oid) == "commit":
            refs.append((ref, oid, kind))
    if git.run(["symbolic-ref", "-q", "HEAD"], check=False).returncode != 0:
        head = git.run(["rev-parse", "--verify", "HEAD"], check=False)
        if head.returncode == 0:
            refs.append(("HEAD", head.stdout.decode("ascii").strip(), "commit"))
    return refs


def _require_rewritable(git: Git) -> None:
    """Refuse to rewrite history where that could lose work or miss commits."""

    def fail(reason: str) -> None:
        raise RuntimeError(f"cannot rewrite history: {reason}")

    shallow = git.run(["rev-parse", "--is-shallow-repository"]).stdout.strip()
    if shallow == b"true":
        fail("this is a shallow clone; fetch the full history with `git fetch --unshallow`")
    replaced = git.run(["for-each-ref", "--count=1", "refs/replace/"]).stdout
    if replaced or git.path("info/grafts").exists():
        fail("the repository uses replace refs or grafts")
    if git.run(["for-each-ref", "--count=1", f"{ORIGINAL_REFS}/"]).stdout:
        fail(
            f"{ORIGINAL_REFS} holds a previous rewrite; once you no longer need it:\n\n"
            f"  {DELETE_ORIGINAL_REFS}"
        )
    for name, operation in (
        ("MERGE_HEAD", "a merge"),
        ("CHERRY_PICK_HEAD", "a cherry-pick"),
        ("REVERT_HEAD", "a revert"),
        ("rebase-merge", "a rebase"),
        ("rebase-apply", "a rebase or git am"),
        ("BISECT_LOG", "a bisect"),
    ):
        if git.path(name).exists():
            fail(f"{operation} is in progress")
    worktrees = git.run(["worktree", "list", "--porcelain"]).stdout
    if worktrees.count(b"worktree ") > 1:
        fail("the repository has other worktrees; remove them with `git worktree remove`")
    if git.run(["status", "--porcelain", "--untracked-files=no"]).stdout:
        fail("there are uncommitted changes; commit or stash them first")


def _confirm_rewrite(refs: list[str]) -> bool:
    sys.stdout.flush()
    tty = _open_interactive_tty()
    if tty is None:
        raise RuntimeError("cannot ask for confirmation without a terminal; pass --yes")
    tty_in, tty_out = tty
    try:
        tty_out.write("\nThis rewrites " + ", ".join(refs) + ".\n")
        tty_out.write("Everyone who has a copy must re-clone or reset onto the new history.\n")
        tty_out.write('Type "rewrite" to continue: ')
        tty_out.flush()
        return tty_in.readline().strip() == "rewrite"
    finally:
        tty_in.close()
        tty_out.close()


def _update_refs(git: Git, moves: list[tuple[str, str, str]]) -> None:
    """Move every ref, backing up its old value under ORIGINAL_REFS, all or none."""

    commands = ["start"]
    for ref, old, new in moves:
        commands.append(f"create {ORIGINAL_REFS}/{ref} {old}")
        if ref == "HEAD":
            commands.append("option no-deref")
        commands.append(f"update {ref} {new} {old}")
    commands += ["prepare", "commit"]
    git.run(
        ["update-ref", "-m", "git-age audit --rekey", "--stdin"],
        input_bytes=("\n".join(commands) + "\n").encode(),
        error="cannot update the refs; none was changed",
    )


def run_history_rekey(config: Config, git: Git) -> int:
    options = config.options
    if options.revisions or options.reflog:
        raise RuntimeError("--rekey rewrites all local branches and tags; it takes no revisions")
    _require_rewritable(git)
    if not options.yes and not config.options.dry_run:
        tty = _open_interactive_tty()
        if tty is None:
            raise RuntimeError("cannot ask for confirmation without a terminal; pass --yes")
        for stream in tty:
            stream.close()

    refs = _rewritable_refs(git)
    history = History(git, sorted({oid for _, oid, _ in refs}))
    assert history.current is not None
    resolve_recipients(config, history.current)
    if not config.options.dry_run:
        config.age.prepare()
        check_recipient_trust(config)
    if not options.plaintext_only:
        config.age.require_identities()

    with ObjectReader(git) as reader:
        rewrite = HistoryRewrite(config, history, reader)
        moves = rewrite.run(refs)
        key_leaks = find_leaks(history, reader).keys

    if rewrite.undecryptable and not options.keep_undecryptable:
        _err(
            f"git-age: cannot decrypt {len(rewrite.undecryptable)} protected file version(s):",
            *_indented(
                f"{path.as_posix()} in {commit[:12]}"
                for (path, _), commit in sorted(rewrite.undecryptable.items())
            ),
        )
        raise RuntimeError(
            "nothing was changed; pass --keep-undecryptable to keep what you cannot decrypt "
            "as it is, or --plaintext-only to only encrypt plaintext"
        )

    changed = sum(old != new for old, new in rewrite.commits.items())
    print(
        f"git-age: {'would rewrite' if config.options.dry_run else 'rewriting'} {changed} of "
        f"{len(history.commits)} commit(s) and {len(moves)} ref(s): "
        f"{rewrite.encrypted} plaintext version(s) encrypted, {rewrite.reencrypted} re-encrypted"
    )
    if rewrite.undecryptable:
        print(f"  kept {len(rewrite.undecryptable)} version(s) you cannot decrypt as they are")
    if rewrite.signatures:
        print(f"  {rewrite.signatures} commit or tag signature(s) will be dropped")
    if config.options.verbose or config.options.dry_run:
        for ref, old, new in moves:
            print(f"  {ref}: {old[:12]} -> {'(new)' if config.options.dry_run else new[:12]}")
    if key_leaks:
        _err(
            f"git-age: warning: {len({leak.path for leak in key_leaks})} private key file(s) "
            "are in Git history, and stay there; `git-age audit` lists them.",
            *_key_leak_advice(),
        )
    if config.options.dry_run or not moves:
        if not moves:
            print("git-age: history is already encrypted; nothing to do")
        return 0

    if not options.yes and not _confirm_rewrite([ref for ref, _, _ in moves]):
        raise RuntimeError("rewrite not confirmed; nothing was changed")

    head = git.run(["rev-parse", "--verify", "HEAD"], check=False).stdout.decode().strip()
    unlocked = {
        item.path for item in history.current.protected_files() if item.state is FileState.UNLOCKED
    }
    _update_refs(git, moves)

    new_head = git.run(["rev-parse", "--verify", "HEAD"], check=False).stdout.decode().strip()
    if head and new_head != head:
        git.run(
            ["read-tree", "-m", "-u", head, new_head],
            error="the refs moved, but cannot update the working tree; run `git reset --hard`",
        )
        relock = [
            item
            for item in history.current.protected_files()
            if item.path in unlocked and item.state is FileState.LOCKED
        ]
        if relock:
            _unlock(config, relock)

    pushes = sorted({ref for ref, _, _ in moves if ref.startswith(("refs/heads/", "refs/tags/"))})
    _err(
        f"git-age: history rewritten; the old refs are under {ORIGINAL_REFS}.",
        "",
        "Next:",
        "  * Check the result, e.g. `git log -p` and `git-age audit -- --branches --tags`;",
        "    a plain `git-age audit` also searches the remote-tracking refs, which keep",
        "    the old history until you push.",
        "  * Publish it: `git push --force-with-lease origin "
        + " ".join(ref.removeprefix("refs/heads/").removeprefix("refs/tags/") for ref in pushes)
        + "`.",
        "  * Others must re-clone; a pull would merge the old history back in.",
        "  * Once you are sure, delete the old history here:",
        f"      {DELETE_ORIGINAL_REFS}",
        "      git reflog expire --expire=now --all && git gc --prune=now",
        "  * Change the secrets anyway: old clones, forks and the server's caches keep",
        "    the old history.",
    )
    return 0


def run_audit(config: Config) -> int:
    git = Git.at(config.root)
    options = config.options
    if not options.rekey and (options.plaintext_only or options.keep_undecryptable or options.yes):
        raise RuntimeError("--plaintext-only, --keep-undecryptable and --yes need --rekey")
    if options.rekey:
        return run_history_rekey(config, git)

    # What a rekey backed up is the old history it replaced.
    revisions = options.revisions or [f"--exclude={ORIGINAL_REFS}/*", "--all"]
    if options.reflog:
        revisions = [*revisions, "--reflog"]
    history = History(git, revisions)
    with ObjectReader(git) as reader:
        leaks = find_leaks(history, reader)
        if not leaks.plaintext and not leaks.keys:
            print(
                "git-age: no protected file was committed as plaintext and no private key "
                f"was committed in {len(history.commits)} commit(s)"
            )
            return 0
        _print_leaks(config, leaks, reader)
    return 1


def _validate_managed_hook(hook_path: pathlib.Path, hook_name: str) -> None:
    """
    Refuse to overwrite hooks we do not own.

    Validate all hook paths before writing any of them so `install`
    does not knowingly replace one managed hook and then discover that a
    later target belongs to another tool.
    """

    if not hook_path.exists():
        return

    try:
        existing = hook_path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise RuntimeError(
            f"{hook_name} hook already exists and is not readable as text: {hook_path}"
        ) from exc

    if _hook_marker(hook_name) not in existing:
        raise RuntimeError(
            f"refusing to overwrite an existing non-git-age {hook_name} hook:\n"
            f"  {hook_path}\n\n"
            "Compose the hooks manually or move the existing hook first."
        )


def run_install(config: Config) -> int:
    """
    Install the managed Git hooks and, unless --no-diff, the diff driver.

    `pre-commit` enforces the plaintext policy, and `pre-push` refuses to
    push what slipped past it.
    """

    options = config.options
    git = Git.at(config.root)
    hooks_dir = git.hooks_directory()

    attributes = options.diff or options.filter or options.merge
    hooks = _managed_hooks(attributes)

    for name, _ in hooks:
        _validate_managed_hook(hooks_dir / name, name)

    attributes_path = git.path("info/attributes")

    # Each step describes itself, so --dry-run reports exactly what would run.
    steps: list[tuple[str, Callable[[], object]]] = []

    def install_hook(path: pathlib.Path, content: str) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        _atomic_write(path, content.encode("utf-8"), mode=0o755)

    for name, content in hooks:
        path = hooks_dir / name
        verb = "update" if path.exists() else "install"
        steps.append((f"{verb} git-age {name} hook: {path}", partial(install_hook, path, content)))

    # Without the Git attributes there is nothing to keep in sync; remove
    # only the sync hooks git-age installed.
    for name in sorted(set(SYNC_HOOK_EVENTS) - {name for name, _ in hooks}):
        path = hooks_dir / name
        try:
            ours = _hook_marker(name) in path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            ours = False
        if ours:
            steps.append((f"remove git-age {name} hook: {path}", path.unlink))

    settings = {
        HOOK_MODE_CONFIG: options.mode,
        UNLOCK_AFTER_COMMIT_CONFIG: options.unlock_after_commit,
    }
    for key, value in settings.items():
        if value is not None:
            value = str(value).lower()  # True/False -> true/false
            steps.append(
                (f"set repo git config {key}={value}", partial(git.config_set, key, value))
            )

    verb = "set" if options.diff else "unset"
    steps.append(
        (
            f"{verb} repo git config {DIFF_TEXTCONV_CONFIG}",
            partial(_configure_diff_driver, git, options.diff),
        )
    )
    verb = "set" if options.merge else "unset"
    steps.append(
        (
            f"{verb} repo git config {MERGE_DRIVER_CONFIG}",
            partial(_configure_merge_driver, git, options.merge),
        )
    )
    verb = "set" if options.filter else "unset"
    steps.append(
        (
            f"{verb} repo git config {FILTER_CLEAN_CONFIG}, {FILTER_SMUDGE_CONFIG} "
            f"and {FILTER_REQUIRED_CONFIG}",
            partial(_configure_filter, git, options.filter),
        )
    )
    if attributes:
        description = f"write git-age patterns to {attributes_path}"
    else:
        description = f"remove git-age patterns from {attributes_path}"
    steps.append(
        (
            description,
            partial(_update_attributes_block, git, install=attributes, remove=not attributes),
        )
    )

    if config.options.dry_run:
        for description, _ in steps:
            print(f"would {description}")
        return 0

    for _, action in steps:
        action()

    # Report the effective values, which may come from global config or env.
    mode = _effective_hook_mode(git.root)
    unlock_after_commit = _effective_unlock_after_commit(git.root)

    if not _on_path("git-age"):
        _err(
            "git-age: warning: `git-age` is not on PATH; the hooks run "
            "`git age` and will fail until it is."
        )

    width = max(len(name) for name, _ in hooks)
    for name, _ in hooks:
        print(f"Installed git-age {name + ' hook:':<{width + 6}} {hooks_dir / name}")
    print(f"Pre-commit policy: {mode.value}")
    print(f"Unlock after commit: {'yes' if unlock_after_commit else 'no'}")
    print(f"Plaintext diffs: {'yes' if options.diff else 'no'}")
    print(f"Unchanged unlocked files hidden: {'yes' if options.filter else 'no'}")
    print(f"Clean filter required: {'yes' if options.filter else 'no'}")
    print(f"Decrypted merges: {'yes' if options.merge else 'no'}")
    if attributes:
        print(f"Attributes: {attributes_path}")
    print()
    print(
        f"Change policy: git config {HOOK_MODE_CONFIG} <mode>, "
        f"git config {UNLOCK_AFTER_COMMIT_CONFIG} true|false"
    )
    print(f"Temporary pre-commit override: {HOOK_MODE_ENV}=<mode> git commit ...")
    print(f"Temporary post-commit override: {UNLOCK_AFTER_COMMIT_ENV}=1|0 git commit ...")
    print(f"Push plaintext or keys anyway: {ALLOW_PLAINTEXT_PUSH_ENV}=1 git push ...")
    return 0


def _local_config_set(git: Git, key: str) -> bool:
    """Whether key is set in repo git config itself, not inherited."""

    result = git.run(["config", "--local", "--get-all", key], check=False)
    return result.returncode == 0


def run_uninstall(config: Config) -> int:
    """
    Remove what `install` set up: the hooks git-age owns, the repo git
    config it sets, and the generated block in info/attributes.

    Keys, the user's key and recipient settings, `.gitage` files and the
    protected files themselves are left as they are.
    """

    git = Git.at(config.root)
    hooks_dir = git.hooks_directory()
    attributes_path = git.path("info/attributes")

    # Each step describes itself, so --dry-run reports exactly what would run.
    steps: list[tuple[str, str, Callable[[], object]]] = []
    foreign_hooks: list[pathlib.Path] = []

    existing = attributes_path.read_text(encoding="utf-8") if attributes_path.is_file() else ""
    if _split_attributes_block(existing)[2]:
        steps.append(
            (
                f"remove git-age patterns from {attributes_path}",
                f"Removed git-age patterns from {attributes_path}",
                partial(_update_attributes_block, git, install=False, remove=True),
            )
        )

    for key in INSTALL_CONFIG_KEYS:
        if _local_config_set(git, key):
            steps.append(
                (
                    f"unset repo git config {key}",
                    f"Unset repo git config {key}",
                    partial(
                        git.run,
                        ["config", "--local", "--unset-all", key],
                        error=f"could not update git config {key}",
                    ),
                )
            )

    for name in MANAGED_HOOK_EVENTS:
        path = hooks_dir / name
        if not path.exists() and not path.is_symlink():
            continue
        try:
            ours = _hook_marker(name) in path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            ours = False
        if ours:
            steps.append(
                (
                    f"remove git-age {name} hook: {path}",
                    f"Removed git-age {name} hook: {path}",
                    path.unlink,
                )
            )
        else:
            foreign_hooks.append(path)

    if config.options.dry_run:
        for description, _, _ in steps:
            print(f"would {description}")
    else:
        for _, done, action in steps:
            action()
            print(done)
    if not steps:
        print("git-age: nothing to uninstall")

    for path in foreign_hooks:
        print(f"Kept {path.name} hook, which git-age did not install: {path}")
    kept = [key for key in USER_CONFIG_KEYS if _local_config_set(git, key)]
    if kept:
        print(f"Kept repo git config {', '.join(kept)}; unset with git config --unset KEY")
    print()
    print("Keys, .gitage files and protected files are left as they are, locked or")
    print("unlocked. Nothing stops committing protected files as plaintext any more;")
    print("`git-age install` sets everything up again.")
    return 0


def _private_keys_refused(leaks: list[pathlib.PurePosixPath]) -> bool:
    """Report staged private keys; True when the commit must be aborted."""

    if not leaks:
        return False
    if not _env_flag(ALLOW_PRIVATE_KEYS_ENV):
        _print_private_keys_staged(leaks)
        _err("git-age: commit aborted.")
        return True
    _err(f"git-age: committing private keys by explicit choice ({ALLOW_PRIVATE_KEYS_ENV}).")
    return False


def run_pre_commit_hook(config: Config, repository: Repository) -> int:
    mode = _effective_hook_mode(repository.root)
    aborted = "git-age: commit aborted."

    # Private keys are refused in every mode; encrypting them is not an
    # option because .gitage.key is never a protected file.
    if _private_keys_refused(resolve_staged_private_keys(repository)):
        return 1

    # A commit that changes [recipients] must re-encrypt existing ciphertext.
    # A change committed earlier only warns, so unrelated commits still work.
    stale = staged_stale_files(repository)
    if stale:
        _print_staged_stale(stale)
        if any(baseline.uncommitted for _, baseline in stale):
            if not _env_flag(ALLOW_STALE_RECIPIENTS_ENV):
                _err(aborted)
                return 1
            _err(
                "git-age: committing stale ciphertext by explicit choice "
                f"({ALLOW_STALE_RECIPIENTS_ENV})."
            )

    staged = resolve_staged_protected_files(repository)
    plaintext = [item for item in staged if item.state is FileState.UNLOCKED]

    if not plaintext:
        return 0

    _print_plaintext_staged(plaintext)

    if mode is HookMode.ABORT:
        _err(f"git-age: hook policy is {mode.value}; commit aborted.")
        return 1

    if mode is HookMode.INTERACTIVE:
        choice = _prompt_hook_choice()

        if choice is None:
            _err("git-age: interactive confirmation is unavailable.", aborted)
            return 1

        if choice is HookChoice.ABORT:
            _err(aborted)
            return 1

        if choice is HookChoice.COMMIT:
            _err("git-age: committing protected files as plaintext by explicit choice.")
            return 0

    # Git refuses an empty commit before running this hook, unless --amend or
    # --allow-empty asked for one. So only an index that differed from HEAD
    # and is made identical by encryption is an accidental empty commit.
    git = repository.git
    assert git is not None
    differed_from_head = not git.index_matches_head()

    try:
        check_recipient_trust(config)
        left_unchanged = encrypt_staged_files(config, repository, plaintext)
    except Exception as exc:
        _err(f"git-age: could not encrypt staged files: {exc}", aborted)
        return 1

    _err("git-age: encrypted staged protected files:", *_indented(item.path for item in plaintext))

    if left_unchanged:
        _err(
            "",
            "git-age: working-tree copies were left unlocked because they contain "
            "unstaged changes or could not be safely replaced:",
            *_indented(left_unchanged),
        )

    if differed_from_head and git.index_matches_head():
        if not _env_flag(ALLOW_EMPTY_ENV):
            _err(
                "",
                "git-age: nothing to commit; the staged files encrypt to the "
                "ciphertext already in HEAD.",
                f"git-age: to amend or commit anyway, set {ALLOW_EMPTY_ENV}=1.",
                aborted,
            )
            return 1
        _err(f"git-age: committing without changes by explicit choice ({ALLOW_EMPTY_ENV}).")

    return 0


def run_post_commit_hook(config: Config, repository: Repository) -> int:
    """
    Optionally unlock protected working-tree files after a successful commit.

    This hook runs after Git has already created the commit, so failure here
    can only be reported; it cannot roll the commit back.
    """

    try:
        enabled = _effective_unlock_after_commit(repository.root)
    except Exception as exc:
        _err("", "git-age: commit succeeded, but post-commit policy evaluation failed:", f"  {exc}")
        return 1

    if not enabled:
        return 0

    protected_files = repository.protected_files()
    locked_files = [item for item in protected_files if item.state is FileState.LOCKED]

    if not locked_files:
        return 0

    try:
        left_locked = {item.path for item in _unlock(config, protected_files)}
    except Exception as exc:
        _err(
            "",
            "git-age: commit succeeded, but automatic unlock failed:",
            f"  {exc}",
            "",
            "Protected files may remain locked. Run `git-age unlock` "
            "after fixing the key configuration.",
        )
        return 1

    unlocked = [item for item in locked_files if item.path not in left_locked]
    if not unlocked:
        return 0

    _err(
        "",
        "git-age: unlocked protected working-tree files after commit:",
        *_indented(_display_path(config, item.path) for item in unlocked),
        "",
        "git-age: Git stores the encrypted versions, so these files appear "
        "modified while unlocked, unless the clean filter is installed and "
        "they are unchanged.",
    )
    return 0


def _pushed_revisions(
    git: Git, remote: str, updates: Iterable[str]
) -> tuple[list[str], list[str]]:
    """
    What a push sends, from the `<local ref> <local oid> <remote ref>
    <remote oid>` lines Git gives the pre-push hook: the pushed oids, and
    the rev-list revisions of what the remote already has, as far as this
    repository knows. Deleted refs send nothing.
    """

    pushed: list[str] = []
    known: list[str] = []
    for line in updates:
        fields = line.split()
        if len(fields) != 4:
            continue
        _local_ref, local_oid, _remote_ref, remote_oid = fields
        if NULL_OID_PATTERN.fullmatch(local_oid):
            continue
        pushed.append(local_oid)
        # The remote's old value may be a commit this repository never fetched.
        if not NULL_OID_PATTERN.fullmatch(remote_oid) and git.has_commit(remote_oid):
            known.append(remote_oid)
    # A remote given as a URL has no remote-tracking refs; that matches nothing.
    return pushed, [*known, f"--remotes={remote}"]


def run_pre_push_hook(config: Config, git: Git, updates: Iterable[str]) -> int:
    """
    Refuse a push that would publish protected plaintext or private keys.

    pre-commit cannot see commits made with --no-verify, or by a rebase,
    cherry-pick or merge, so this audits what is pushed, and only that.
    """

    pushed, on_remote = _pushed_revisions(git, config.options.push_remote, updates)
    if not pushed:
        return 0
    # Without a .gitage in the working tree, e.g. on an orphan branch or with
    # a global core.hooksPath, only commits with their own rules can leak;
    # without any in the pushed tips either, the hook stays out of the way.
    current_rules = bool(find_gitage_files(git.root, in_git=True))
    if not current_rules and not any(
        path.name == RULE_FILE_NAME
        for oid in pushed
        for path in git.tree(oid)
    ):
        return 0

    history = History(git, [*pushed, "--not", *on_remote], current_rules=current_rules)
    with ObjectReader(git) as reader:
        leaks = find_leaks(history, reader)
        if not leaks.plaintext and not leaks.keys:
            return 0
        _print_leaks(config, leaks, reader, pushing=True)
    if _env_flag(ALLOW_PLAINTEXT_PUSH_ENV):
        _err(f"git-age: pushing them by explicit choice ({ALLOW_PLAINTEXT_PUSH_ENV}).")
        return 0
    _err("git-age: push aborted.")
    return 1


# ---------------------------------------------------------------------------
# help: the manual
# ---------------------------------------------------------------------------

MANUAL_HEADING = re.compile(r"^(\S.*)\n(-+)$", re.MULTILINE)


def manual() -> str:
    """The manual: this module's docstring."""

    if not __doc__:
        raise RuntimeError("the manual is not available: Python runs with -OO")
    return __doc__.strip("\n") + "\n"


def manual_sections() -> dict[str, str]:
    """The sections of the manual, heading included, by title."""

    text = manual()
    headings = [
        match
        for match in MANUAL_HEADING.finditer(text)
        if len(match.group(1)) == len(match.group(2))
    ]
    ends = [heading.start() for heading in headings[1:]] + [len(text)]
    return {
        heading.group(1): text[heading.start() : end].rstrip() + "\n"
        for heading, end in zip(headings, ends)
    }


def _topic_name(title: str) -> str:
    """How to name a section on the command line: QUICK START is quick-start."""

    return "-".join(title.lower().lstrip(".").replace("_", " ").replace("-", " ").split())


def _command_parsers(
    parser: argparse.ArgumentParser,
) -> dict[str, tuple[argparse.ArgumentParser, str]]:
    """parser's subcommands with their help, in order."""

    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            helps = {choice.dest: choice.help or "" for choice in action._choices_actions}
            return {name: (sub, helps.get(name, "")) for name, sub in action.choices.items()}
    return {}


def run_help(config: Config) -> int:
    """
    The whole manual, paged on a terminal; or one section, matched by its
    name, a word of it or a unique prefix; or a command's options.
    """

    topic = config.options.topic
    if topic is None:
        _page(config.root, manual())
        return 0

    sections = manual_sections()
    wanted = _topic_name(topic)
    words = {title: [_topic_name(title), *_topic_name(title).split("-")] for title in sections}
    commands = {
        name: sub
        for name, (sub, _help) in _command_parsers(build_parser()).items()
        if name not in INTERNAL_COMMANDS
    }

    matches = [title for title in sections if _topic_name(title) == wanted]
    if not matches:
        matches = [title for title, names in words.items() if wanted in names]
    if not matches and wanted in commands:
        sys.stdout.write(commands[wanted].format_help())
        return 0
    if not matches:
        matches = [
            title for title, names in words.items() if any(n.startswith(wanted) for n in names)
        ]
    if len(matches) == 1 and wanted:
        sys.stdout.write(sections[matches[0]])
        return 0

    topics = ", ".join(_topic_name(title) for title in (matches or sections))
    problem = "ambiguous" if len(matches) > 1 else "unknown"
    raise RuntimeError(
        f"{problem} help topic '{topic}'; {'it could be' if matches else 'topics are'}: "
        f"{topics}; or a command, see `git-age --help`"
    )


def _pager(root: pathlib.Path) -> str:
    """The pager command: Git's inside Git, else PAGER, else less."""

    with contextlib.suppress(RuntimeError, OSError, subprocess.CalledProcessError):
        git = Git.containing(root)
        if git is not None:
            return os.fsdecode(git.run(["var", "GIT_PAGER"]).stdout.rstrip(b"\n"))
    if os.environ.get("PAGER"):
        return os.environ["PAGER"]
    return "less -FRX" if shutil.which("less") else ""


def _page(root: pathlib.Path, text: str) -> None:
    """Show text through the pager on a terminal, as Git does; else print it."""

    pager = _pager(root) if sys.stdout.isatty() else ""
    shell = shutil.which("sh")
    if pager.strip() in ("", "cat") or shell is None:
        sys.stdout.write(text)
        return

    sys.stdout.flush()
    # Like Git: let less quit at the end and pass colors through.
    environment = {"LESS": "FRX", "LV": "-c", **os.environ}
    content = text.encode(sys.stdout.encoding or "utf-8", errors="replace")
    process = subprocess.Popen([shell, "-c", pager], stdin=subprocess.PIPE, env=environment)
    # The pager handles Ctrl-C.
    with _signal_handlers(signal.SIG_IGN, "SIGINT", "SIGQUIT"):
        assert process.stdin is not None
        with contextlib.suppress(BrokenPipeError):
            process.stdin.write(content)
        with contextlib.suppress(BrokenPipeError):
            process.stdin.close()
        process.wait()


# ---------------------------------------------------------------------------
# completion: shell completion scripts, generated from the parser
# ---------------------------------------------------------------------------


class CompletionOption(NamedTuple):
    names: list[str]
    help: str
    value: str | list[str] | None
    repeatable: bool
    metavar: str


class CompletionPositional(NamedTuple):
    nargs: str | None
    value: str | list[str]
    metavar: str


class CompletionCommand(NamedTuple):
    name: str
    help: str
    options: list[CompletionOption]
    positionals: list[CompletionPositional]


def _completion_value(action: argparse.Action) -> str | list[str]:
    """What completes action's value: these words, "file", "dir" or "none"."""

    words = getattr(action, "completions", None) or action.choices
    if words is not None:
        return [str(word) for word in words]
    if action.type is pathlib.Path:
        return "dir" if action.metavar == "DIR" else "file"
    return "none"


def _completion_command(name: str, parser: argparse.ArgumentParser, help: str) -> CompletionCommand:
    options = []
    positionals = []
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction) or action.help == argparse.SUPPRESS:
            continue
        metavar = str(action.metavar or action.dest).upper()
        if action.option_strings:
            options.append(
                CompletionOption(
                    names=list(action.option_strings),
                    help=(action.help or "").replace("%%", "%"),
                    value=None if action.nargs == 0 else _completion_value(action),
                    repeatable=isinstance(action, argparse._AppendAction),
                    metavar=metavar,
                )
            )
        else:
            positionals.append(
                CompletionPositional(
                    nargs=action.nargs if isinstance(action.nargs, str) else None,
                    value=_completion_value(action),
                    metavar=metavar,
                )
            )
    return CompletionCommand(name, help, options, positionals)


def completion_commands(
    parser: argparse.ArgumentParser,
) -> tuple[CompletionCommand, list[CompletionCommand]]:
    """The global options, and the commands that completion offers."""

    commands = [
        _completion_command(name, sub, help)
        for name, (sub, help) in _command_parsers(parser).items()
        if name not in INTERNAL_COMMANDS
    ]
    top = _completion_command("", parser, "")
    command_names = [command.name for command in commands]
    top = top._replace(positionals=[CompletionPositional(None, command_names, "COMMAND")])
    return top, commands


def _bash_words(value: str | list[str]) -> str:
    """The arguments of __git_age_values for value."""

    if isinstance(value, list):
        return "words " + " ".join(shlex.quote(word) for word in value)
    return value


def bash_completion(parser: argparse.ArgumentParser) -> str:
    top, commands = completion_commands(parser)
    option_cases = []
    options_cases = []
    positional_cases = []
    for command in [top, *commands]:
        name = shlex.quote(command.name) if command.name else "''"
        names = " ".join(n for option in command.options for n in option.names)
        options_cases.append(f"    {name}) options={shlex.quote(names)} ;;")
        for option in command.options:
            if option.value is not None:
                patterns = "|".join(f"{command.name}:{n}" for n in option.names)
                option_cases.append(f"    {patterns}) kind=({_bash_words(option.value)}) ;;")
        for index, positional in enumerate(command.positionals):
            slot = "*" if positional.nargs in ("*", "+") else str(index)
            positional_cases.append(
                f"    {command.name}:{slot}) kind=({_bash_words(positional.value)}) ;;"
            )
            if slot == "*":
                break
    return BASH_COMPLETION.format(
        option_cases="\n".join(option_cases),
        options_cases="\n".join(options_cases),
        positional_cases="\n".join(positional_cases),
    )


BASH_COMPLETION = r"""# bash completion for git-age, generated by `git-age completion bash`.
# Load it with: source <(git-age completion bash)
# `git age` completes through _git_age, which Git's completion calls.

# __git_age_option COMMAND OPTION: set kind to how OPTION's value completes;
# fail when OPTION takes no value. Global options have an empty COMMAND.
__git_age_option() {{
  case $1:$2 in
{option_cases}
    *) return 1 ;;
  esac
}}

# __git_age_options COMMAND: set options to COMMAND's options.
__git_age_options() {{
  case $1 in
{options_cases}
    *) options= ;;
  esac
}}

# __git_age_positional COMMAND N: set kind to how COMMAND's Nth argument
# (from 0) completes; with an empty COMMAND, the command itself.
__git_age_positional() {{
  case $1:$2 in
{positional_cases}
    *) kind=(none) ;;
  esac
}}

# __git_age_values KIND [WORD...]: complete $cur as a file, dir, none or a WORD.
__git_age_values() {{
  local kind=$1
  shift
  case $kind in
    file | dir)
      compopt -o filenames 2>/dev/null
      if declare -F _filedir >/dev/null; then
        if [[ $kind == dir ]]; then _filedir -d; else _filedir; fi
      elif [[ $kind == dir ]]; then
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
      else
        mapfile -t COMPREPLY < <(compgen -f -- "$cur")
      fi
      ;;
    words) mapfile -t COMPREPLY < <(compgen -W "$*" -- "$cur") ;;
    *) COMPREPLY=() ;;
  esac
}}

# __git_age_complete START: complete words[cword], where words[START] is the
# first word after git-age.
__git_age_complete() {{
  local cur=${{words[cword]}} opt= prefix= end=$cword command= n=0 dashdash= i word options
  local -a kind
  COMPREPLY=()
  # Git's completion sets nospace for its own options.
  compopt +o nospace 2>/dev/null
  if [[ $cur == --*=* ]]; then
    # Bash completes after the =, unless COMP_WORDBREAKS lacks it.
    [[ ${{COMP_WORDS[COMP_CWORD]}} == "$cur" ]] && prefix=${{cur%%=*}}=
    opt=${{cur%%=*}} cur=${{cur#*=}}
  elif [[ $cur == = ]]; then
    opt=${{words[cword - 1]}} cur= end=$((cword - 1))
  elif [[ ${{words[cword - 1]}} == = ]]; then
    opt=${{words[cword - 2]}} end=$((cword - 2))
  fi

  for ((i = $1; i < end; i++)); do
    word=${{words[i]}}
    if [[ -z $dashdash && $word == -- ]]; then
      dashdash=1
    elif [[ -z $dashdash && $word == -?* ]]; then
      if [[ ${{words[i + 1]}} == = ]]; then
        ((i += 2))
      elif [[ $word != *=* ]] && __git_age_option "$command" "$word"; then
        ((i++))
      fi
    elif [[ -z $command ]]; then
      command=$word
    else
      ((n++))
    fi
  done

  if [[ -n $opt ]]; then
    __git_age_option "$command" "$opt" && __git_age_values "${{kind[@]}}"
    COMPREPLY=("${{COMPREPLY[@]/#/$prefix}}")
  elif ((end > $1)) && [[ -z $dashdash && ${{words[end - 1]}} == -?* ]] &&
    __git_age_option "$command" "${{words[end - 1]}}"; then
    __git_age_values "${{kind[@]}}"
  elif [[ -z $dashdash && $cur == -* ]]; then
    __git_age_options "$command"
    mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")
  else
    __git_age_positional "$command" "$n"
    __git_age_values "${{kind[@]}}"
  fi
  return 0
}}

_git_age_main() {{
  local cur prev words cword
  if declare -F _get_comp_words_by_ref >/dev/null; then
    _get_comp_words_by_ref -n = cur prev words cword
  else
    words=("${{COMP_WORDS[@]}}") cword=$COMP_CWORD
  fi
  __git_age_complete 1
}}

# Git's completion calls this for `git age`, with words and cword set.
_git_age() {{
  __git_age_complete $((${{__git_cmd_idx:-1}} + 1))
}}

complete -F _git_age_main git-age
