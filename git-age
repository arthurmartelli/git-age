        metavar="TOPIC",
        help="a section of the manual, such as hooks or trust, or a command",
    )
    # Not choices: topics may be abbreviated. Completion offers these.
    setattr(
        topic,
        "completions",
        [
            *(_topic_name(title) for title in manual_sections()),
            *(name for name in subparsers.choices if name not in INTERNAL_COMMANDS),
        ],
    )

    completion_parser = subparsers.add_parser(
        "completion", help="print the shell completion script for bash, zsh or fish"
    )
    completion_parser.add_argument("shell", metavar="SHELL", choices=sorted(COMPLETION_GENERATORS))

    textconv_parser = subparsers.add_parser(
        "textconv", help="print a file decrypted; Git diff driver entrypoint"
    )
    textconv_parser.add_argument("file", type=pathlib.Path)

    clean_parser = subparsers.add_parser(
        "clean", help="reuse unchanged ciphertext for a file; Git clean filter entrypoint"
    )
    clean_parser.add_argument("file", type=pathlib.PurePosixPath)

    merge_parser = subparsers.add_parser(
        "merge", help="merge decrypted versions of a file; Git merge driver entrypoint"
    )
    merge_parser.add_argument("--path", type=pathlib.PurePosixPath, required=True)
    merge_parser.add_argument("--marker-size", type=int, default=7)
    merge_parser.add_argument("base", type=pathlib.Path)
    merge_parser.add_argument("ours", type=pathlib.Path)
    merge_parser.add_argument("theirs", type=pathlib.Path)

    hook_parser = subparsers.add_parser("hook", help="internal Git hook entrypoint")
    hook_subparsers = hook_parser.add_subparsers(dest="hook_event", required=True)
    for event in MANAGED_HOOK_EVENTS:
        event_parser = hook_subparsers.add_parser(event)
        if event == "pre-push":
            event_parser.add_argument("push_remote", metavar="REMOTE")
            event_parser.add_argument("push_url", metavar="URL")

    # So that code shared between commands can read these on commands without them.
    parser.set_defaults(recipients=[], identities=[], no_reuse=False, paths=[])
    return parser


def parse_args(argv: list[str] | None = None) -> Config:
    args = build_parser().parse_args(argv)

    root = args.root.expanduser().resolve()
    command = args.command

    # Resolved at run time, so that generated hooks never embed private key paths.
    identities = (
        []
        if command == "keygen" or command in DOCUMENTATION_COMMANDS
        else _resolve_identities(root, args.identities)
    )

    return Config(
        command=command,
        root=root,
        age=Age(identities=identities, reuse=not args.no_reuse),
        options=args,
    )


# ---------------------------------------------------------------------------
# Repository discovery / rule parsing
# ---------------------------------------------------------------------------


@dataclass
class Repository:
    """The .gitage rules that apply under root, and their recipients."""

    root: pathlib.Path
    git: Git | None
    # Outermost first, so nested .gitage files override their ancestors.
    rule_sets: list[RuleSet]
    # Kept even with -C subdir, since its [recipients] apply to every file.
    top_rule_file: pathlib.Path
    recipients: list[str] | None = None
    staged: bool = False
    _baselines: dict[tuple[pathlib.Path, bool], Baseline | None] = field(
        default_factory=dict, init=False, repr=False
    )
    _recipient_lists: RecipientLists | None = field(default=None, init=False, repr=False)

    @classmethod
    def build(
        cls, root: pathlib.Path, git: Git | None, rule_sets: list[RuleSet], *, staged: bool = False
    ) -> Repository:
        """Order the rule sets and find the top-level [recipients]."""

        top_file = (git.root if git is not None else root) / RULE_FILE_NAME
        recipients = next(
            (rule_set.recipients for rule_set in rule_sets if rule_set.path == top_file), None
        )
        rule_sets = sorted(rule_sets, key=lambda item: (len(item.root.parts), item.path.as_posix()))
        return cls(root, git, rule_sets, top_file, recipients, staged)

    @classmethod
    def from_working_tree(cls, root: pathlib.Path) -> Repository:
        if not root.exists():
            raise RuntimeError(f"directory does not exist: {root}")
        if not root.is_dir():
            raise RuntimeError(f"not a directory: {root}")

        git = Git.containing(root)
        rule_paths = find_gitage_files(root, in_git=git is not None)
        if git is not None:
            # With -C subdir, rule files in the directories above it still apply.
            above = _rule_files_above(git.root, git.relative(root) or pathlib.PurePosixPath())
            rule_paths = above + rule_paths
        if not rule_paths:
            raise RuntimeError(f"no {RULE_FILE_NAME} files found under {git.root if git else root}")

        return cls.build(root, git, [parse_gitage_file(path) for path in rule_paths])

    @classmethod
    def from_index(cls, git: Git) -> Repository:
        """
        Build the repository from the .gitage files in Git's index.

        `check --cached` and the pre-commit hook judge what the commit will
        contain, so rule files are read from their staged blobs: a partially
        staged or unstaged .gitage edit must not change the verdict. The
        whole index is considered, from the Git root, even with -C subdir.
        """

        entries = cls.staged_rule_files(git)
        if not entries:
            raise RuntimeError(f"no {RULE_FILE_NAME} files staged in {git.root}")
        return cls.from_blobs(git, entries, "staged")

    @staticmethod
    def staged_rule_files(git: Git) -> list[tuple[pathlib.PurePosixPath, str]]:
        """The (path, blob oid) of every regular .gitage file in the index."""

        return [
            (entry.path, entry.oid)
            for entry in git.index().values()
            if entry.path.name == RULE_FILE_NAME and entry.is_regular
        ]

    @classmethod
    def removed_rule_files(cls, git: Git) -> list[pathlib.PurePosixPath]:
        """
        Every regular .gitage file in HEAD that the index no longer has.

        Committing that would silently unprotect the files its rules cover.
        A moved .gitage counts too, since its rules then cover other files,
        and so does one replaced by a symlink, since those are ignored.
        """

        if not git.has_commit("HEAD"):
            return []
        staged = {path for path, _ in cls.staged_rule_files(git)}
        result = git.run(["ls-tree", "-r", "-z", "HEAD"])
        return sorted(
            path
            for (mode, _kind, _oid), path in _ls_records(result.stdout)
            if path.name == RULE_FILE_NAME and mode in REGULAR_FILE_MODES and path not in staged
        )

    @classmethod
    def from_blobs(
        cls, git: Git, entries: Iterable[tuple[pathlib.PurePosixPath, str]], source: str
    ) -> Repository:
        """
        Build the repository from .gitage blobs, given as (path relative to
        the Git root, blob oid); source, e.g. "staged", prefixes errors.
        """

        rule_sets: list[RuleSet] = []
        for path, oid in entries:
            rule_file = git.absolute(path)
            try:
                contents = git.read_blob(oid).decode("utf-8")
            except UnicodeDecodeError as exc:
                raise RuntimeError(
                    f"{source} {rule_file}: {RULE_FILE_NAME} must be UTF-8 text"
                ) from exc
            try:
                rule_sets.append(parse_gitage_text(rule_file, contents))
            except RuntimeError as exc:
                raise RuntimeError(f"{source} {exc}") from exc
        return cls.build(git.root, git, rule_sets, staged=True)

    def relative(self, git_path: pathlib.PurePosixPath) -> pathlib.PurePosixPath | None:
        """Turn a Git-root-relative path into one relative to root, if it is under root."""

        assert self.git is not None
        absolute = self.git.absolute(git_path)
        if not absolute.is_relative_to(self.root):
            return None
        return pathlib.PurePosixPath(absolute.relative_to(self.root).as_posix())

    def protection(self, relative_path: pathlib.PurePosixPath) -> Protection | None:
        """
        The final positive rule protecting a path relative to root, if any.

        This is path-based rather than file-based, which lets the Git hook
        apply the same rules to blobs in the index even when their
        working-tree contents differ.
        """

        if relative_path.name in CONTROL_FILE_NAMES:
            return None

        absolute = self.root.joinpath(*relative_path.parts)
        protection: Protection | None = None
        for rule_set in self.rule_sets:
            if not absolute.is_relative_to(rule_set.root):
                continue
            relative = pathlib.PurePosixPath(absolute.relative_to(rule_set.root).as_posix())
            for rule in rule_set.rules:
                if rule.matches(relative):
                    protection = None if rule.negate else Protection(rule, rule_set.path)
        return protection

    def recipient_chain(
        self, directory: pathlib.Path, *, include_top: bool = True
    ) -> list[RuleSet]:
        """
        The rule sets whose [recipients] apply to files in directory: the
        top-level one, unless include_top is false, and every nested one
        above directory, outermost first.
        """

        return [
            rule_set
            for rule_set in self.rule_sets
            if rule_set.recipients is not None
            and directory.is_relative_to(rule_set.root)
            and (include_top or rule_set.path != self.top_rule_file)
        ]

    def recipient_lists(self) -> RecipientLists:
        """
        Every [recipients] list in the repository; unlike rule_sets, also
        those outside root when git-age runs on a subdirectory with -C.
        """

        if self._recipient_lists is None:
            rule_sets = self.rule_sets
            if self.git is not None and not self.staged and self.root != self.git.root:
                rule_sets = [
                    parse_gitage_file(path)
                    for path in find_gitage_files(self.git.root, in_git=True)
                ]
            self._recipient_lists = _recipient_lists(rule_sets, self.top_rule_file.parent)
        return self._recipient_lists

    def baseline(self, directory: pathlib.Path, *, include_top: bool = True) -> Baseline | None:
        """recipients_baseline(), cached per directory."""

        key = (directory, include_top)
        if key not in self._baselines:
            self._baselines[key] = recipients_baseline(self, directory, include_top=include_top)
        return self._baselines[key]

    def is_stale(self, protected_file: ProtectedFile, *, include_top: bool = True) -> bool:
        """
        Whether a locked working-tree file is still encrypted to previous
        recipients: its bytes equal its version from before they last
        changed, so it was not re-encrypted since and needs `git-age rekey`.
        """

        git_path = protected_file.git_path
        if self.git is None or protected_file.state is not FileState.LOCKED or git_path is None:
            return False
        baseline = self.baseline(protected_file.path.parent, include_top=include_top)
        if baseline is None:
            return False
        previous = self.git.blob(f"{baseline.rev}:{git_path.as_posix()}")
        return previous is not None and previous == protected_file.path.read_bytes()

    def protected_files(self) -> list[ProtectedFile]:
        protected_files: list[ProtectedFile] = []
        for path in _list_regular_files(self.root, in_git=self.git is not None):
            protection = self.protection(
                pathlib.PurePosixPath(path.relative_to(self.root).as_posix())
            )
            if protection is not None:
                protected_files.append(
                    ProtectedFile(path, self.git, detect_file_state(path), protection)
                )
        return protected_files


def _rule_files_above(git_root: pathlib.Path, path: pathlib.PurePosixPath) -> list[pathlib.Path]:
    """
    The .gitage files in git_root and the directories below it down to the
    one containing path (relative to git_root), outermost first. Only these
    can affect path.
    """

    candidates = (
        git_root.joinpath(*path.parts[:depth], RULE_FILE_NAME) for depth in range(len(path.parts))
    )
    return [
        candidate for candidate in candidates if not candidate.is_symlink() and candidate.is_file()
    ]


def find_gitage_files(root: pathlib.Path, *, in_git: bool) -> list[pathlib.Path]:
    result = [
        path for path in _list_regular_files(root, in_git=in_git) if path.name == RULE_FILE_NAME
    ]

    # Parent rules first, nested rules later so nested .gitage files can
    # override their ancestors.
    return sorted(result, key=lambda path: (len(path.relative_to(root).parts), path.as_posix()))


def _rstrip_unescaped_spaces(line: str) -> str:
    end = len(line)

    while end > 0 and line[end - 1] == " ":
        backslashes = 0
        index = end - 2
        while index >= 0 and line[index] == "\\":
            backslashes += 1
            index -= 1
        if backslashes % 2 == 1:
            break
        end -= 1

    return line[:end]


SECTION_HEADER = re.compile(r"\[([a-z][a-z0-9-]*)\]")
FILES_SECTION = "files"
RECIPIENTS_SECTION = "recipients"
KNOWN_SECTIONS = {FILES_SECTION, RECIPIENTS_SECTION}


def parse_gitage_file(path: pathlib.Path) -> RuleSet:
    try:
        contents = path.read_text(encoding="utf-8")
    except UnicodeDecodeError as exc:
        raise RuntimeError(f"{path}: {RULE_FILE_NAME} must be UTF-8 text") from exc

    return parse_gitage_text(path, contents)


def parse_gitage_text(path: pathlib.Path, contents: str) -> RuleSet:
    """
    Parse the sectioned .gitage format:

        [files]        gitignore-like patterns
        [recipients]   one age recipient or SSH public key per line

    Every entry must be inside a section. Unknown and repeated sections are
    errors so typos fail loudly instead of silently dropping entries.
    """

    rules: list[Rule] = []
    recipients: list[str] | None = None
    section: str | None = None
    seen_sections: set[str] = set()

    for line_number, raw_line in enumerate(contents.splitlines(), start=1):
        line = _rstrip_unescaped_spaces(raw_line.rstrip("\r"))
        if not line or line.lstrip().startswith("#"):
            continue

        header = SECTION_HEADER.fullmatch(line.strip())
        if header is not None:
            name = header.group(1)
            if name not in KNOWN_SECTIONS:
                known = ", ".join(f"[{known}]" for known in sorted(KNOWN_SECTIONS))
                raise RuntimeError(
                    f"{path}:{line_number}: unknown section [{name}]; expected one of: {known}"
                )
            if name in seen_sections:
                raise RuntimeError(f"{path}:{line_number}: duplicate section [{name}]")
            seen_sections.add(name)
            section = name
            if name == RECIPIENTS_SECTION:
                recipients = []
            continue

        if section is None:
            raise RuntimeError(
                f"{path}:{line_number}: {line!r} is outside a section; "
                f"start the file with [{FILES_SECTION}]"
            )

        if section == FILES_SECTION:
            negate = False
            if line.startswith("!"):
                negate = True
                line = line[1:]
                if not line:
                    raise RuntimeError(f"{path}:{line_number}: empty negation rule")

            rules.append(Rule(pattern=line, negate=negate, line_number=line_number))

        elif section == RECIPIENTS_SECTION:
            assert recipients is not None
            recipient = line.strip()
            if not recipient.startswith(("age1", "ssh-")):
                raise RuntimeError(
                    f"{path}:{line_number}: {recipient!r} is not an age recipient "
                    "(age1...) or SSH public key (ssh-...)"
                )
            if recipient not in recipients:
                recipients.append(recipient)

    if recipients == []:
        raise RuntimeError(f"{path}: [{RECIPIENTS_SECTION}] section is empty")

    return RuleSet(path=path, rules=rules, recipients=recipients)


# ---------------------------------------------------------------------------
# Pattern matching
# ---------------------------------------------------------------------------


def _glob_to_regex(pattern: str) -> re.Pattern[str]:
    output: list[str] = []
    index = 0

    while index < len(pattern):
        char = pattern[index]

        if char == "\\":
            index += 1
            if index >= len(pattern):
                output.append(re.escape("\\"))
                break
            output.append(re.escape(pattern[index]))
            index += 1
            continue

        if char == "*":
            if index + 1 < len(pattern) and pattern[index + 1] == "*":
                while index + 1 < len(pattern) and pattern[index + 1] == "*":
                    index += 1

                if index + 1 < len(pattern) and pattern[index + 1] == "/":
                    output.append("(?:.*/)?")
                    index += 2
                else:
                    output.append(".*")
                    index += 1
                continue

            output.append("[^/]*")
            index += 1
            continue

        if char == "?":
            output.append("[^/]")
            index += 1
            continue

        if char == "[":
            close = index + 1
            if close < len(pattern) and pattern[close] in "!^":
                close += 1
            if close < len(pattern) and pattern[close] == "]":
                close += 1
            while close < len(pattern) and pattern[close] != "]":
                close += 1

            if close >= len(pattern):
                output.append(re.escape("["))
                index += 1
                continue

            stuff = pattern[index + 1 : close]
            if stuff.startswith("!"):
                stuff = "^" + stuff[1:]
            elif stuff.startswith("^"):
                stuff = "\\" + stuff

            stuff = stuff.replace("\\", "\\\\")
            output.append(f"[{stuff}]")
            index = close + 1
            continue

        output.append(re.escape(char))
        index += 1

    return re.compile("".join(output))


# ---------------------------------------------------------------------------
# Working-tree protected-file resolution
# ---------------------------------------------------------------------------


def _list_regular_files(root: pathlib.Path, *, in_git: bool) -> list[pathlib.Path]:
    """
    Return the regular, non-symlink files under root, sorted.

    Inside a Git work tree this is Git's own view: tracked files plus
    untracked files that are not ignored, so ignored directories such as
    `node_modules` and nested repositories are never visited.
    """

    candidates = _git_candidate_files(root) if in_git else _walk_candidate_files(root)

    return sorted(path for path in set(candidates) if not path.is_symlink() and path.is_file())


def _git_candidate_files(root: pathlib.Path) -> list[pathlib.Path]:
    # Tracked files may be missing from the working tree, and untracked nested
    # repositories are listed as `dir/`; the caller's is_file() check drops both.
    result = _run_git(root, ["ls-files", "--cached", "--others", "--exclude-standard", "-z"])
    return [
        root / os.fsdecode(entry)
        for entry in result.stdout.split(b"\0")
        if entry and not entry.endswith(b"/")
    ]


def _walk_candidate_files(root: pathlib.Path) -> list[pathlib.Path]:
    files: list[pathlib.Path] = []

    for directory, dirnames, filenames in os.walk(root, followlinks=False):
        directory_path = pathlib.Path(directory)
        dirnames[:] = [
            name for name in dirnames if name != ".git" and not (directory_path / name).is_symlink()
        ]
        files.extend(directory_path / name for name in filenames)

    return files


# ---------------------------------------------------------------------------
# State detection
# ---------------------------------------------------------------------------


def detect_content_state(content: bytes) -> FileState:
    if content.startswith(AGE_HEADER) or content.startswith(AGE_ARMORED_HEADER):
        return FileState.LOCKED
    return FileState.UNLOCKED


def detect_file_state(path: pathlib.Path) -> FileState:
    max_header = max(len(AGE_HEADER), len(AGE_ARMORED_HEADER))
    try:
        with path.open("rb") as file:
            header = file.read(max_header)
    except OSError:
        return FileState.UNKNOWN

    return detect_content_state(header)


