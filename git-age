        return self.scopes is None or self.scopes.encrypted_to_user(path)


def resolve_path(root: pathlib.Path, path: pathlib.Path) -> pathlib.Path:
    path = path.expanduser()
    if not path.is_absolute():
        path = root / path
    return path.resolve()


def _git_config_get(root: pathlib.Path, key: str, *, value_type: str | None = None) -> str | None:
    """
    Read a single git config value as seen from root, or None if unset.
    """

    args = ["config"]
    if value_type is not None:
        args.append(f"--type={value_type}")
    args.extend(["--get", key])

    result = _run_git(root, args, error=f"could not read git config {key}", allowed=(0, 1))
    if result.returncode == 1:
        return None
    return os.fsdecode(result.stdout.rstrip(b"\n"))


def _git_config_get_all(
    root: pathlib.Path, key: str, *, value_type: str | None = None, empty_clears: bool = False
) -> list[str]:
    """
    Read every value of a multi-valued key, across all config levels in
    Git's order. Blank values are dropped. With empty_clears, a blank value
    also clears the ones before it, like Git's own credential.helper.
    """
    args = ["config", "--get-all", "-z", key]
    if value_type is not None:
        args.insert(1, f"--type={value_type}")
    result = _run_git(root, args, check=False)
    if result.returncode != 0:
        return []

    values: list[str] = []
    # -z ends every value with NUL, which leaves an empty last piece.
    for raw in result.stdout.split(b"\0")[:-1]:
        value = os.fsdecode(raw)
        if value.strip():
            values.append(value)
        elif empty_clears:
            values.clear()
    return values


def _unique_paths(root: pathlib.Path, values: list[str] | list[pathlib.Path]) -> list[pathlib.Path]:
    result: list[pathlib.Path] = []
    for value in values:
        path = resolve_path(root, pathlib.Path(value))
        if path not in result:
            result.append(path)
    return result


def _resolve_identities(
    root: pathlib.Path, explicit_identities: list[pathlib.Path]
) -> list[pathlib.Path]:
    """
    Resolve the user's own private keys; the first source that is set wins:

        1. -i / --identity (repeatable)
        2. GIT_AGE_KEY_FILE (paths separated by os.pathsep, ':' on Unix)
        3. git config age.keyFile (multi-valued)
        4. the .gitage.key at the repository root, see local_key_file()
    """

    if explicit_identities:
        return _unique_paths(root, explicit_identities)

    env_keys = [value for value in os.environ.get(KEY_FILE_ENV, "").split(os.pathsep) if value]
    if env_keys:
        return _unique_paths(root, env_keys)

    # An empty age.keyFile clears the ones before it, so a repo can replace
    # globally configured keys instead of adding to them.
    config_keys = _git_config_get_all(root, KEY_FILE_CONFIG, value_type="path", empty_clears=True)
    if config_keys:
        return _unique_paths(root, config_keys)

    local_key = local_key_file(root)
    if local_key.is_file():
        return [local_key]

    return []


def local_key_file(root: pathlib.Path) -> pathlib.Path:
    """
    The .gitage.key at the top of the working tree containing root, or in
    root itself outside Git, so it is found from any subdirectory.
    """

    # Git runs filters and hooks from the top level, which contains .git;
    # this spares every such invocation a rev-parse.
    if (root / ".git").exists():
        return root / LOCAL_KEY_FILE_NAME
    git = Git.containing(root)
    return (root if git is None else git.root) / LOCAL_KEY_FILE_NAME


def _format_identities(identities: list[pathlib.Path]) -> str:
    if not identities:
        return "no identity"
    label = "identity" if len(identities) == 1 else "identities"
    return f"{label} " + ", ".join(os.fspath(path) for path in identities)


def resolve_recipients(config: Config, repository: Repository) -> None:
    """
    Resolve who files are encrypted to; the first source that is set wins:

        1. -r / --recipient
        2. GIT_AGE_RECIPIENT
        3. [recipients] in the top-level .gitage
        4. git config age.recipient
        5. none: encrypt to the user's own identity

    Nested [recipients] are added per directory, see RecipientScopes.
    """

    age = config.age
    env_recipient = os.environ.get(RECIPIENT_ENV)
    config_recipients = _git_config_get_all(config.root, RECIPIENT_CONFIG)
    tracked = False

    if config.options.recipients:
        age.recipients, age.source = list(config.options.recipients), "-r/--recipient"
    elif env_recipient:
        age.recipients, age.source = [env_recipient], RECIPIENT_ENV
    elif repository.recipients is not None:
        age.recipients = list(repository.recipients)
        age.source = f"{_display_path(config, repository.top_rule_file)} [{RECIPIENTS_SECTION}]"
        tracked = True
    elif config_recipients:
        age.recipients, age.source = config_recipients, f"git config {RECIPIENT_CONFIG}"
    else:
        age.recipients, age.source = [], None
        tracked = True

    # Only tracked lists show in .gitage's history, so only their changes
    # can leave existing ciphertext encrypted to a previous list.
    config.scopes = RecipientScopes(repository, age, tracked)


