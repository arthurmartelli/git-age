def _exclude_from_git(path: pathlib.Path) -> pathlib.Path | None:
    """
    Add path to the repository's info/exclude so `git add -A` skips it.

    Returns the exclude file when an entry was added, None when path is
    outside a Git worktree or is already excluded.
    """

    git = Git.containing(path.parent)
    relative = None if git is None else git.relative(path)
    if git is None or relative is None:
        return None

    exclude = git.path("info/exclude")
    entry = "/" + relative.as_posix()
    existing = exclude.read_text(encoding="utf-8") if exclude.is_file() else ""
    if entry in existing.splitlines():
        return None

    exclude.parent.mkdir(parents=True, exist_ok=True)
    with exclude.open("a", encoding="utf-8") as file:
        if existing and not existing.endswith("\n"):
            file.write("\n")
        file.write(f"# git-age private key\n{entry}\n")
    return exclude


def run_keygen(config: Config) -> int:
    requested = config.options.output
    output = (
        local_key_file(config.root)
        if requested is None
        else resolve_path(config.root, requested)
    )

    if output.exists():
        raise RuntimeError(f"refusing to overwrite existing key: {output}")
    if not output.parent.is_dir():
        raise RuntimeError(f"output directory does not exist: {output.parent}")

    if config.options.dry_run:
        print(f"would generate identity: {output}")
        return 0

    age_keygen = _require_executable("age-keygen")

    try:
        subprocess.run([age_keygen, "-o", os.fspath(output)], check=True)
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(f"age-keygen failed with exit status {exc.returncode}") from exc

    os.chmod(output, 0o600)

    excluded = None if config.options.no_exclude else _exclude_from_git(output)

    try:
        result = subprocess.run(
            [age_keygen, "-y", os.fspath(output)], check=True, stdout=subprocess.PIPE, text=True
        )
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(
            "identity was generated, but deriving its public recipient failed"
        ) from exc

    recipient = result.stdout.strip()

    print()
    print(f"Identity:  {output}")
    print(f"Recipient: {recipient}")
    print()
    print("WARNING: this file contains a PRIVATE age identity.")
    print("Do not commit it to the repository.")
    if excluded is not None:
        print(f"Added it to {_display_path(config, excluded)} so Git ignores it.")
    print()
    print("You can use it here temporarily with:")
    print("  git-age lock")
    print("  git-age unlock")
    print()
    print("Then move it somewhere private and point git config at it, for example:")
    print("  mkdir -p ~/.config/git-age")
    print(f"  mv {output.name} ~/.config/git-age/myrepo.key")
    print(f"  git config {KEY_FILE_CONFIG} ~/.config/git-age/myrepo.key")
    print()
    print("Use `git config --global` (or an includeIf block) to share it across repos.")
    print()

    return 0


def select_protected_files(
    config: Config,
    repository: Repository,
    protected_files: list[ProtectedFile],
    paths: list[pathlib.Path],
) -> list[ProtectedFile]:
    """
    The protected files at or under paths, which are relative to -C as in
    Git; all of them without paths. Like Git's "pathspec did not match", a
    path that matches none is an error, saying why: .gitage stays the only
    source of what is protected, so naming a file never protects it.
    """

    if not paths:
        return protected_files

    targets: list[pathlib.Path] = []
    for path in paths:
        target = resolve_path(config.root, path)
        if not target.is_relative_to(repository.root):
            raise RuntimeError(f"{path.as_posix()}: outside {repository.root}")
        targets.append(target)

    selected = [
        item
        for item in protected_files
        if any(item.path.is_relative_to(target) for target in targets)
    ]
    unmatched = [
        f"{path}: {_why_unmatched(repository, target)}"
        for path, target in zip(paths, targets)
        if not any(item.path.is_relative_to(target) for item in selected)
    ]
    if unmatched:
        label = "path matches" if len(unmatched) == 1 else "paths match"
        raise RuntimeError("\n".join([f"{label} no protected file:", *_indented(unmatched)]))
    return selected


def _why_unmatched(repository: Repository, target: pathlib.Path) -> str:
    """Why target, under repository.root, is not one of its protected files."""

    if not target.exists():
        return "no such file or directory"
    if target.is_dir():
        return f"no file in it is protected by {RULE_FILE_NAME}"
    relative = pathlib.PurePosixPath(target.relative_to(repository.root).as_posix())
    if repository.protection(relative) is None:
        return f"not protected by {RULE_FILE_NAME}; add it to [{FILES_SECTION}] to protect it"
    if not target.is_file():
        return "not a regular file"
    return "ignored by Git"


def _print_stale(config: Config, paths: list[pathlib.Path]) -> None:
    _err(
        f"git-age: these files are still encrypted to a previous "
        f"[{RECIPIENTS_SECTION}] list (run `git-age rekey`):",
        *_indented(_display_path(config, path) for path in paths),
    )


def _apply_to_files(
    config: Config,
    protected_files: list[ProtectedFile],
    verb: str,
    action: Callable[[Config, ProtectedFile], bytes],
    *,
    skip: FileState | None = None,
) -> list[tuple[ProtectedFile, str]]:
    """
    Replace each protected file with what action (lock_content,
    unlock_content, rekey_content) returns, all-or-nothing, reporting under
    --dry-run and --verbose. Files in the skip state are already done; a
    file of unknown state stops the run before any file changes.

    Returns the files the action skipped, with the reason.
    """

    skipped: list[tuple[ProtectedFile, str]] = []
    replaced: list[ProtectedFile] = []
    with Transaction() as transaction:
        for protected_file in protected_files:
            display_path = _display_path(config, protected_file.path)

            if protected_file.state is skip:
                if config.options.verbose:
                    print(f"already {verb}ed: {display_path}")
                continue
            if protected_file.state is FileState.UNKNOWN:
                raise RuntimeError(f"cannot determine file state: {display_path}")
            if config.options.dry_run:
                print(f"would {verb}: {display_path}")
                continue
            if config.options.verbose:
                print(f"{verb}ing: {display_path}")

            try:
                transaction.stage(protected_file.path, partial(action, config, protected_file))
            except Skip as reason:
                skipped.append((protected_file, str(reason)))
                if config.options.verbose:
                    print(f"skipped, {reason}: {display_path}")
            else:
                replaced.append(protected_file)

        transaction.commit()

    _forget_stat(replaced)
    return skipped


def _forget_stat(protected_files: list[ProtectedFile]) -> None:
    """
    Let `git status` judge rewritten files by content, best effort: see
    Git.forget_stat(). With the clean filter, an unlocked file that is
    unchanged then shows as unmodified.
    """

    by_git: dict[pathlib.Path, tuple[Git, list[pathlib.PurePosixPath]]] = {}
    for protected_file in protected_files:
        git_path = protected_file.git_path
        if protected_file.git is not None and git_path is not None:
            by_git.setdefault(protected_file.git.root, (protected_file.git, []))[1].append(git_path)
    for git, paths in by_git.values():
        try:
            git.forget_stat(paths)
        except Exception as exc:
            _err(f"git-age: warning: {exc}; git status may show unchanged files as modified")


def _print_skipped(
    config: Config, skipped: list[tuple[ProtectedFile, str]], *, rekey: bool = False
) -> None:
    no_access = [_display_path(config, item.path) for item, why in skipped if why == NO_ACCESS]
    not_rekeyed = [
        _display_path(config, item.path) for item, why in skipped if why == NOT_REKEYED
    ]

    if no_access and rekey:
        _err(
            "git-age: cannot re-encrypt these files, which are not encrypted to you; "
            "someone who can decrypt them must run `git-age rekey`:",
            *_indented(no_access),
        )
    elif no_access and not config.options.verbose:
        _err(
            f"git-age: left {len(no_access)} file(s) locked that are not encrypted to you "
            "(`git-age status` marks them)"
        )
    if not_rekeyed:
        _err(
            "git-age: these files are not re-encrypted to you yet; "
            "someone who can decrypt them must run `git-age rekey`:",
            *_indented(not_rekeyed),
        )


def run_lock(config: Config, repository: Repository, protected_files: list[ProtectedFile]) -> int:
    if not config.options.dry_run and any(item.state is FileState.UNLOCKED for item in protected_files):
        check_recipient_trust(config)

    _apply_to_files(config, protected_files, "lock", lock_content, skip=FileState.LOCKED)

    if not config.options.dry_run:
        assert config.scopes is not None
        # Read again, now that they are locked; with PATHs, only the chosen ones.
        selected = {item.path for item in protected_files}
        stale = [
            item.path
            for item in repository.protected_files()
            if item.path in selected
            and repository.is_stale(item, include_top=config.scopes.tracked)
        ]
        if stale:
            _print_stale(config, stale)

    return 0


def run_rekey(config: Config, protected_files: list[ProtectedFile]) -> int:
    if not config.options.dry_run:
        config.age.prepare()
        check_recipient_trust(config)

    skipped = _apply_to_files(config, protected_files, "rekey", rekey_content)

    if not config.options.dry_run:
        skipped_paths = {item.path for item, _ in skipped}
        done = [item for item in protected_files if item.path not in skipped_paths]
        targets = {config.age_for(item.path).target for item in done}
        target = targets.pop() if len(targets) == 1 else "the recipients of their directories"
        print(f"git-age: re-encrypted {len(done)} file(s) to {target}")
        _print_skipped(config, skipped, rekey=True)

    return 0


def run_unlock(config: Config, protected_files: list[ProtectedFile]) -> int:
    _unlock(config, protected_files)
    return 0


def _unlock(config: Config, protected_files: list[ProtectedFile]) -> list[ProtectedFile]:
    """Unlock what can be unlocked, reporting the rest; returns the files left locked."""

    skipped = _apply_to_files(
        config, protected_files, "unlock", unlock_content, skip=FileState.UNLOCKED
    )
    _print_skipped(config, skipped)
    return [item for item, _ in skipped]


def run_edit(config: Config, repository: Repository, protected_files: list[ProtectedFile]) -> int:
    """
    Decrypt a locked file to a private copy, open the editor on it and, if
    the content changed, encrypt it to the current recipients in place,
    like lock_content(). An unchanged file keeps its bytes.
    """

    file = config.options.file
    if resolve_path(config.root, file).is_dir():
        raise RuntimeError(f"cannot edit {file}: is a directory")
    (protected_file,) = select_protected_files(config, repository, protected_files, [file])
    path = protected_file.path
    display_path = _display_path(config, path)

    if protected_file.state is FileState.UNKNOWN:
        raise RuntimeError(f"cannot determine file state: {display_path}")
    if protected_file.state is FileState.UNLOCKED:
        if config.options.dry_run:
            print(f"would edit in place, as it is unlocked: {display_path}")
            return 0
        _err(f"git-age: {display_path} is unlocked; editing it in place")
        _run_editor(_editor(protected_file.git), path)
        return 0

    if config.options.dry_run:
        print(f"would edit: {display_path}")
        return 0

    # Fail before the editor opens, rather than lose the changes after it.
    editor = _editor(protected_file.git)
    check_recipient_trust(config)
    age = config.age_for(path)
    age.prepare()
    signature = _file_signature(path)
    try:
        plaintext = unlock_content(config, protected_file)
    except Skip as reason:
        raise RuntimeError(f"cannot edit {display_path}: {reason}") from None

    try:
        edited = _edit_privately(protected_file, plaintext, editor)
    except RuntimeError as exc:
        raise RuntimeError(f"{exc}; {display_path} was not changed") from exc
    if edited == plaintext:
        print(f"git-age: {display_path} unchanged")
        return 0

    ciphertext = age.encrypt_reusing(protected_file.git, protected_file.git_path, edited)
    if _file_signature(path) != signature:
        raise RuntimeError(
            f"{display_path} changed while you edited it; it was left as it is, "
            "and your changes were discarded"
        )
    _atomic_write(path, ciphertext)
    _forget_stat([protected_file])
    print(f"git-age: encrypted your changes to {display_path}")
    return 0


def _edit_privately(protected_file: ProtectedFile, plaintext: bytes, editor: str) -> bytes:
    """
    Let the user edit plaintext in a temporary file, and return the result.

    The file is in a fresh 0700 directory inside the Git directory, as for
    the merge driver, rather than next to the protected file: editors keep
    swap and backup files next to what they edit, and in the working tree
    `git add -A` could commit those, and file watchers or sync tools read
    them. Outside Git there is no such directory, so it goes next to the
    file, as a Transaction's does; never in the shared temporary directory.
    The directory is deleted whatever happens, a closed terminal included.
    """

    path = protected_file.path
    if protected_file.git is not None:
        parent, prefix = protected_file.git.path("."), "git-age-edit-"
    else:
        parent, prefix = path.parent, _temporary_prefix(path)

    with _signal_handlers(_exit_on_signal, "SIGHUP", "SIGTERM"):
        with tempfile.TemporaryDirectory(dir=parent, prefix=prefix) as directory:
            # The file's own name, so that the editor recognizes its type.
            copy = pathlib.Path(directory, path.name)
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0)
            with os.fdopen(os.open(copy, flags, 0o600), "wb") as output:
                output.write(plaintext)
            _run_editor(editor, copy)
            try:
                return copy.read_bytes()
            except FileNotFoundError:
                raise RuntimeError("the editor removed the temporary file") from None


def _editor(git: Git | None) -> str:
    """The editor command, chosen as Git does; inside Git, Git chooses it."""

    if git is not None:
        result = git.run(["var", "GIT_EDITOR"], error="cannot determine the editor")
        return os.fsdecode(result.stdout.rstrip(b"\n"))

    dumb = os.environ.get("TERM", "dumb") == "dumb"
    for name in ("GIT_EDITOR", *(() if dumb else ("VISUAL",)), "EDITOR"):
        if os.environ.get(name):
            return os.environ[name]
    if dumb:
        raise RuntimeError("cannot determine the editor: the terminal is dumb, but EDITOR is unset")
    return "vi"


def _run_editor(editor: str, path: pathlib.Path) -> None:
    """
    Run editor on path through the shell, as Git does, since it may have
    arguments. Like Git, ignore Ctrl-C while it runs: the editor handles it.
    """

    process = subprocess.Popen([_require_executable("sh"), "-c", f'{editor} "$@"', editor, path])
    with _signal_handlers(signal.SIG_IGN, "SIGINT", "SIGQUIT"):
        status = process.wait()
    if status in (-signal.SIGINT, 128 + signal.SIGINT):
        raise KeyboardInterrupt
    if status != 0:
        raise RuntimeError(f"the editor '{editor}' failed with exit status {status}")


@contextlib.contextmanager
def _signal_handlers(handler: Any, *names: str) -> Iterator[None]:
    """Handle the named signals that the platform has with handler meanwhile."""

    previous: dict[int, Any] = {}
    try:
        for name in names:
            number = getattr(signal, name, None)
            if number is not None:
                previous[number] = signal.signal(number, handler)
        yield
    finally:
        for number, old in previous.items():
            signal.signal(number, old)


def _exit_on_signal(number: int, _frame: object) -> None:
    # Unlike the default action, this runs the cleanup on the way out.
    raise SystemExit(128 + number)


def run_status(config: Config, repository: Repository, protected_files: list[ProtectedFile]) -> int:
    stale = [item.path for item in protected_files if repository.is_stale(item)]

    # -z implies --porcelain.
    if config.options.porcelain or config.options.null_terminated:
        print_porcelain_status(config, protected_files, stale)
        return 0

    print_status(config, protected_files)

    if config.options.verbose:
        print(f"encrypting to: {config.age.target}")

    if stale:
        _err("")
        _print_stale(config, stale)

    pinned = _pinned_trust(repository.root) if repository.git is not None else None
    if pinned is not None and trust_hash(repository.recipient_lists()) != pinned[0]:
        _err(
            f"git-age: the [{RECIPIENTS_SECTION}] lists differ from the ones you trusted; "
            "`git-age lock` shows how"
        )

    return 0


def run_trust(config: Config) -> int:
    git = Git.at(config.root)
    lists = Repository.from_working_tree(git.root).recipient_lists()
    digest = trust_hash(lists)

    if config.options.show:
        print(digest)
        return 0

    pinned = _pinned_trust(git.root)
    if pinned is not None and pinned[0] == digest:
        print(f"git-age: the current [{RECIPIENTS_SECTION}] lists are already trusted")
        return 0

    if pinned is None:
        heading = f"git-age: trusting these [{RECIPIENTS_SECTION}] lists:"
        details = _describe_lists(lists)
    else:
        heading = f"git-age: trusting [{RECIPIENTS_SECTION}] lists changed since you trusted them:"
        details = _trusted_changes(git, lists, pinned[0])
    print(heading, "", *details, "", sep="\n")

    if config.options.dry_run:
        print(f"would set git config {TRUSTED_RECIPIENTS_CONFIG} {digest}")
        return 0

    git.config_set(TRUSTED_RECIPIENTS_CONFIG, digest)
    print(f"git-age: pinned {digest[:12]} in repo git config {TRUSTED_RECIPIENTS_CONFIG}")
    if os.environ.get(TRUSTED_RECIPIENTS_ENV, "").strip():
        _err(f"git-age: warning: {TRUSTED_RECIPIENTS_ENV} is set and takes precedence")
    return 0


def run_check_cached(config: Config, git: Git) -> int:
    """`check --cached`: judge the index, with a repository read from it."""

    removed = Repository.removed_rule_files(git)
    if removed and not _env_flag(ALLOW_REMOVE_ENV):
        _print_removed_rule_files(removed)
        return 1

    repository = Repository.from_index(git)
    leaks = resolve_staged_private_keys(repository)
    if leaks and not _env_flag(ALLOW_PRIVATE_KEYS_ENV):
        _print_private_keys_staged(leaks)
        return 1

    stale = staged_stale_files(repository)
    if stale:
        _print_staged_stale(stale)
        changed_now = any(baseline.uncommitted for _, baseline in stale)
        if changed_now and not _env_flag(ALLOW_STALE_RECIPIENTS_ENV):
            return 1

    staged = resolve_staged_protected_files(repository)
    plaintext = [item for item in staged if item.state is FileState.UNLOCKED]

    if plaintext:
        _print_plaintext_staged(plaintext)
        return 1

    if config.options.verbose:
        print("git-age: staged protected files are locked")
    return 0


def run_check(config: Config, repository: Repository) -> int:
    protected_files = repository.protected_files()
    unlocked = [item for item in protected_files if item.state is FileState.UNLOCKED]
    unknown = [item for item in protected_files if item.state is FileState.UNKNOWN]

    if unknown:
        _err(
            "git-age: could not determine state of protected files:",
            "",
            *_indented(_display_path(config, item.path) for item in unknown),
        )
        return 1

    if unlocked:
        _err(
            "git-age: protected files are currently unlocked:",
            "",
            *_indented(_display_path(config, item.path) for item in unlocked),
            "",
        )
        return 1

    if config.options.verbose:
        print("git-age: protected working-tree files are locked")
    return 0


