# External commands
# ---------------------------------------------------------------------------


def _require_executable(name: str) -> str:
    executable = shutil.which(name)
    if executable is None:
        raise RuntimeError(f"{name} executable not found in PATH")
    return executable


def _on_path(name: str) -> bool:
    """Whether Git finds the program name on PATH."""

    if shutil.which(name) is not None:
        return True
    # Git also runs scripts without a PATHEXT extension, which which() skips.
    return _WINDOWS and any(
        (pathlib.Path(directory) / name).is_file()
        for directory in os.environ.get("PATH", "").split(os.pathsep)
        if directory
    )


def _run_git(
    root: pathlib.Path,
    args: list[str],
    *,
    input_bytes: bytes | None = None,
    check: bool = True,
    error: str | None = None,
    allowed: tuple[int, ...] = (0,),
) -> subprocess.CompletedProcess[bytes]:
    """
    Run git in root. With error, any exit status not in allowed raises
    RuntimeError(error), followed by Git's own message when it printed one.
    """

    result = subprocess.run(
        [_require_executable("git"), "-C", os.fspath(root), *args],
        input=input_bytes,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check and error is None,
    )
    if error is not None and result.returncode not in allowed:
        message = result.stderr.decode(errors="replace").strip()
        raise RuntimeError(f"{error}: {message}" if message else error)
    return result


class Git:
    """A non-bare Git working tree, addressed by its top-level directory."""

    def __init__(self, root: pathlib.Path) -> None:
        self.root = root

    @classmethod
    def at(cls, directory: pathlib.Path) -> Git:
        """The working tree that contains directory."""

        try:
            result = _run_git(directory, ["rev-parse", "--show-toplevel"])
        except subprocess.CalledProcessError as exc:
            message = exc.stderr.decode(errors="replace").strip()
            raise RuntimeError(
                f"not inside a non-bare Git working tree: {directory}"
                + (f" ({message})" if message else "")
            ) from exc
        return cls(pathlib.Path(os.fsdecode(result.stdout.rstrip(b"\n"))).resolve())

    @classmethod
    def containing(cls, directory: pathlib.Path) -> Git | None:
        try:
            return cls.at(directory)
        except RuntimeError:
            return None

    def run(self, args: list[str], **options: Any) -> subprocess.CompletedProcess[bytes]:
        return _run_git(self.root, args, **options)

    def path(self, name: str) -> pathlib.Path:
        """Where Git keeps name, e.g. info/exclude; linked worktrees share info/."""

        result = self.run(["rev-parse", "--git-path", name])
        return self.root / os.fsdecode(result.stdout.rstrip(b"\n"))

    def relative(self, path: pathlib.Path) -> pathlib.PurePosixPath | None:
        """path relative to the Git root, or None when it is outside."""

        if not path.is_relative_to(self.root):
            return None
        return pathlib.PurePosixPath(path.relative_to(self.root).as_posix())

    def absolute(self, git_path: pathlib.PurePosixPath) -> pathlib.Path:
        return self.root.joinpath(*git_path.parts)

    def config_get(self, key: str, *, value_type: str | None = None) -> str | None:
        return _git_config_get(self.root, key, value_type=value_type)

    def config_set(self, key: str, value: str | None) -> None:
        """Set key in repo git config, or unset it when value is None."""

        allowed: tuple[int, ...]
        if value is None:
            # Exit status 5 means the key was not set: nothing to undo.
            args, allowed = ["config", "--local", "--unset", key], (0, 5)
        else:
            args, allowed = ["config", "--local", key, value], (0,)
        self.run(args, error=f"could not update git config {key}", allowed=allowed)

    def hooks_directory(self) -> pathlib.Path:
        """
        Resolve the hooks directory while respecting core.hooksPath.

        Relative core.hooksPath values are relative to the directory where
        normal non-bare hooks run, i.e. the worktree root.
        """

        configured = self.config_get("core.hooksPath", value_type="path")
        if configured is None:
            return self.path("hooks").resolve()

        path = (self.root / pathlib.Path(configured).expanduser()).resolve()
        if path == pathlib.Path("/dev/null"):
            raise RuntimeError("Git hooks are disabled by core.hooksPath=/dev/null")
        return path

    def has_commit(self, rev: str) -> bool:
        result = self.run(["rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}"], check=False)
        return result.returncode == 0

    def blob(self, spec: str) -> bytes | None:
        """The blob named by spec, e.g. `HEAD:path` or `:0:path`, or None if there is none."""

        result = self.run(["cat-file", "blob", spec], check=False)
        return result.stdout if result.returncode == 0 else None

    def read_blob(self, oid: str) -> bytes:
        return self.run(
            ["cat-file", "blob", oid], error=f"could not read staged Git blob {oid}"
        ).stdout

    def write_blob(self, content: bytes) -> str:
        result = self.run(
            ["hash-object", "-w", "--stdin"],
            input_bytes=content,
            error="could not write encrypted Git blob",
        )
        return result.stdout.decode("ascii").strip()

    def tree(self, rev: str) -> dict[pathlib.PurePosixPath, str]:
        """The blob oid of every file in rev."""

        result = self.run(["ls-tree", "-r", "-z", rev])
        return {
            path: oid for (_mode, kind, oid), path in _ls_records(result.stdout) if kind == "blob"
        }

    def index(self) -> dict[pathlib.PurePosixPath, IndexEntry]:
        """Stage-0 index entries (of GIT_INDEX_FILE, during partial commits)."""

        result = self.run(["ls-files", "--stage", "-z"])
        return {
            path: IndexEntry(path, mode, oid)
            for (mode, oid, stage), path in _ls_records(result.stdout)
            if stage == "0"
        }

    def stage(self, contents: list[tuple[IndexEntry, bytes]]) -> None:
        """
        Point each index entry at a blob of new content, keeping its mode.

        This avoids `git add`, which could stage unrelated changes.
        """

        payload = b"".join(
            f"{entry.mode} {self.write_blob(content)}\t".encode("ascii")
            + os.fsencode(entry.path.as_posix())
            + b"\0"
            for entry, content in contents
        )
        if payload:
            self.run(
                ["update-index", "-z", "--index-info"],
                input_bytes=payload,
                error="could not update Git index with encrypted blobs",
            )

    def forget_stat(self, paths: list[pathlib.PurePosixPath]) -> None:
        """
        Make Git compare these files by content again, keeping their blobs.

        Git caches each file's size in the index and calls a file of another
        size modified without running the clean filter. Rewriting a stage-0
        entry unchanged clears that cache, so the next `git status` cleans
        the file, compares, and records the new size. Conflicted and
        untracked paths have no stage-0 entry and are left alone.
        """

        index = self.index()
        entries = [index[path] for path in paths if path in index and index[path].is_regular]
        payload = b"".join(
            f"{entry.mode} {entry.oid}\t".encode("ascii")
            + os.fsencode(entry.path.as_posix())
            + b"\0"
            for entry in entries
        )
        if payload:
            self.run(
                ["update-index", "-z", "--index-info"],
                input_bytes=payload,
                error="could not refresh Git index",
            )

    def staged_changed_paths(self) -> list[pathlib.PurePosixPath]:
        """
        Paths whose stage-0 contents are being added/changed by the commit.

        Deletions have no blob to leak, so they are excluded. Submodules and
        symlinks are filtered later by index mode.
        """

        result = self.run(["diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR"])
        return [
            pathlib.PurePosixPath(os.fsdecode(raw)) for raw in result.stdout.split(b"\0") if raw
        ]

    def index_matches_head(self) -> bool:
        if not self.has_commit("HEAD"):
            return False
        result = self.run(["diff-index", "--cached", "--quiet", "HEAD", "--"], check=False)
        return result.returncode == 0


# ---------------------------------------------------------------------------
# Safe working-tree replacement
# ---------------------------------------------------------------------------


_WINDOWS = os.name == "nt"

# Nothing to copy: the file system has no extended attributes, or one vanished
# meanwhile.
_XATTR_UNSUPPORTED = {errno.ENOTSUP, errno.EOPNOTSUPP, errno.ENODATA, errno.EINVAL}
# The owner of a file may always set these, so failing to is an error.
# Others, such as security.selinux, may need privileges or a policy that
# git-age lacks, and are kept when possible.
_OWNER_XATTR_PREFIXES = ("user.", "system.posix_acl_")

_COPYFILE_ACL = 1 << 0
_COPYFILE_XATTR = 1 << 2
_ACL_TYPE_EXTENDED = 0x100

_REPLACEFILE_IGNORE_MERGE_ERRORS = 0x2
_REPLACEFILE_IGNORE_ACL_ERRORS = 0x4
_SETTABLE_FILE_ATTRIBUTES = (
    stat.FILE_ATTRIBUTE_READONLY
    | stat.FILE_ATTRIBUTE_HIDDEN
    | stat.FILE_ATTRIBUTE_SYSTEM
    | stat.FILE_ATTRIBUTE_ARCHIVE
    | stat.FILE_ATTRIBUTE_TEMPORARY
    | stat.FILE_ATTRIBUTE_OFFLINE
    | stat.FILE_ATTRIBUTE_NOT_CONTENT_INDEXED
)
# Windows refuses to replace files with these.
_BLOCKING_FILE_ATTRIBUTES = (
    stat.FILE_ATTRIBUTE_READONLY | stat.FILE_ATTRIBUTE_HIDDEN | stat.FILE_ATTRIBUTE_SYSTEM
)


def _preserve_metadata(source: pathlib.Path, target: pathlib.Path) -> None:
    """
    Give target the ownership, permissions, ACLs and extended attributes of
    source.

    On Windows, _replace_file and Transaction carry them over instead.
    """

    if _WINDOWS:
        return

    source_stat = source.stat()
    target_stat = target.stat()

    if (target_stat.st_uid, target_stat.st_gid) != (source_stat.st_uid, source_stat.st_gid):
        try:
            os.chown(target, source_stat.st_uid, source_stat.st_gid)
        except PermissionError as exc:
            raise RuntimeError(
                f"cannot preserve ownership of {source}: "
                f"wanted uid={source_stat.st_uid}, gid={source_stat.st_gid}"
            ) from exc

    if hasattr(os, "listxattr"):
        _copy_xattrs(source, target)
    elif sys.platform == "darwin":
        _copy_macos_metadata(source, target)

    # chown can clear special permission bits on Linux, so chmod follows it.
    # An ACL's mask is the group bits, so this also leaves it as in source.
    os.chmod(target, stat.S_IMODE(source_stat.st_mode))


def _copy_xattrs(source: pathlib.Path, target: pathlib.Path) -> None:
    """Make target's extended attributes, POSIX ACLs included, equal source's."""

    try:
        wanted = set(os.listxattr(source))
        present = set(os.listxattr(target))
    except OSError as exc:
        if exc.errno in _XATTR_UNSUPPORTED:
            return
        raise

    # A new file can get attributes source lacks, such as a default ACL.
    for name in sorted(present - wanted):
        _xattr_step(source, name, partial(os.removexattr, target, name))
    for name in sorted(wanted):
        _xattr_step(source, name, partial(_copy_xattr, source, target, name))


def _copy_xattr(source: pathlib.Path, target: pathlib.Path, name: str) -> None:
    value = os.getxattr(source, name)
    try:
        if os.getxattr(target, name) == value:
            return
    except OSError as exc:
        if exc.errno != errno.ENODATA:
            raise
    os.setxattr(target, name, value)


def _xattr_step(source: pathlib.Path, name: str, step: Callable[[], None]) -> None:
    try:
        step()
    except OSError as exc:
        if exc.errno in _XATTR_UNSUPPORTED:
            return
        if exc.errno in (errno.EPERM, errno.EACCES) and not name.startswith(_OWNER_XATTR_PREFIXES):
            return
        raise RuntimeError(
            f"cannot preserve extended attribute {name} of {source}: {exc.strerror}"
        ) from exc


def _copy_macos_metadata(source: pathlib.Path, target: pathlib.Path) -> None:
    """Copy source's ACL and extended attributes to target with copyfile(3)."""

    import ctypes

    libc = _macos_libc()
    # copyfile keeps the entries target inherited from its directory, which
    # source may not have, so start from an empty ACL.
    acl = libc.acl_init(0)
    if not acl:
        raise RuntimeError(f"cannot clear the ACL of {target}: {os.strerror(ctypes.get_errno())}")
    try:
        if libc.acl_set_file(os.fsencode(target), _ACL_TYPE_EXTENDED, acl) != 0:
            error = ctypes.get_errno()
            if error != errno.ENOTSUP:
                raise RuntimeError(f"cannot clear the ACL of {target}: {os.strerror(error)}")
    finally:
        libc.acl_free(acl)

    flags = _COPYFILE_ACL | _COPYFILE_XATTR
    if libc.copyfile(os.fsencode(source), os.fsencode(target), None, flags) == 0:
        return
    error = ctypes.get_errno()
    # Some com.apple.* attributes are reserved to the system.
    if error in (errno.ENOTSUP, errno.EPERM, errno.EACCES):
        return
    raise RuntimeError(
        f"cannot preserve the ACL and extended attributes of {source}: {os.strerror(error)}"
    )


@cache
def _macos_libc() -> Any:
    import ctypes
    import ctypes.util

    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    libc.copyfile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_uint32]
    libc.copyfile.restype = ctypes.c_int
    libc.acl_init.argtypes = [ctypes.c_int]
    libc.acl_init.restype = ctypes.c_void_p
    libc.acl_set_file.argtypes = [ctypes.c_char_p, ctypes.c_int, ctypes.c_void_p]
    libc.acl_set_file.restype = ctypes.c_int
    libc.acl_free.argtypes = [ctypes.c_void_p]
    libc.acl_free.restype = ctypes.c_int
    return libc


@cache
def _kernel32() -> Any:
    import ctypes
    from ctypes import wintypes

    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.ReplaceFileW.argtypes = [
        wintypes.LPCWSTR,
        wintypes.LPCWSTR,
        wintypes.LPCWSTR,
        wintypes.DWORD,
        wintypes.LPVOID,
        wintypes.LPVOID,
    ]
    kernel32.ReplaceFileW.restype = wintypes.BOOL
    kernel32.SetFileAttributesW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD]
    kernel32.SetFileAttributesW.restype = wintypes.BOOL
    return kernel32


def _windows_error(path: pathlib.Path) -> OSError:
    import ctypes

    error = ctypes.WinError(ctypes.get_last_error())
    error.filename = str(path)
    return error


def _replace_file(replacement: pathlib.Path, path: pathlib.Path) -> None:
    """
    os.replace(replacement, path). On Windows, path's ACL, alternate data
    streams and creation time carry over to replacement, as if path had
    been edited in place.
    """

    if not _WINDOWS or not path.exists():
        os.replace(replacement, path)
        return

    flags = _REPLACEFILE_IGNORE_MERGE_ERRORS | _REPLACEFILE_IGNORE_ACL_ERRORS
    if not _kernel32().ReplaceFileW(str(path), str(replacement), None, flags, None, None):
        raise _windows_error(path)


def _set_file_attributes(path: pathlib.Path, attributes: int) -> None:
    attributes &= _SETTABLE_FILE_ATTRIBUTES
    if not _kernel32().SetFileAttributesW(str(path), attributes or stat.FILE_ATTRIBUTE_NORMAL):
        raise _windows_error(path)


def _make_replaceable(path: pathlib.Path) -> int | None:
    """
    On Windows, clear the attributes that keep path from being replaced and
    return all of them, to restore afterwards; elsewhere, return None.
    """

    if not _WINDOWS:
        return None
    attributes = path.stat().st_file_attributes
    if attributes & _BLOCKING_FILE_ATTRIBUTES:
        _set_file_attributes(path, attributes & ~_BLOCKING_FILE_ATTRIBUTES)
    return attributes


def _fsync_path(path: pathlib.Path) -> None:
    # Windows flushes only files opened for writing.
    with path.open("r+b" if _WINDOWS else "rb") as file:
        os.fsync(file.fileno())


def _fsync_directory(path: pathlib.Path) -> None:
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    except OSError:
        return

    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _atomic_write(path: pathlib.Path, content: bytes, *, mode: int | None = None) -> None:
    """
    Replace path with content via a sibling temporary file.

    Without mode, path must exist and keeps its metadata, as in a
    Transaction; with mode, the new file gets exactly that mode.
    """

    if mode is None:
        with Transaction() as transaction:
            transaction.stage(path, lambda: content)
            transaction.commit()
        return

    with tempfile.TemporaryDirectory(
        dir=path.parent, prefix=_temporary_prefix(path)
    ) as temporary_directory:
        output = pathlib.Path(temporary_directory) / "output"
        _write_output(output, content, mode=mode)
        os.replace(output, path)
        _fsync_directory(path.parent)


def _temporary_prefix(path: pathlib.Path) -> str:
    return f".{path.name}.git-age-"


def _write_output(
    output: pathlib.Path,
    content: bytes,
    *,
    source: pathlib.Path | None = None,
    mode: int | None = None,
) -> None:
    """Write content durably, with the metadata of source or exactly mode."""

    output.write_bytes(content)
    if source is not None:
        _preserve_metadata(source, output)
    elif mode is not None:
        os.chmod(output, mode)
    _fsync_path(output)


def _file_signature(path: pathlib.Path) -> tuple[int, ...]:
    """What changes whenever a file is rewritten, replaced or chmodded."""

    st = path.stat()
    return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)


@dataclass
class _StagedReplacement:
    path: pathlib.Path
    directory: pathlib.Path
    signature: tuple[int, ...]
    keep: bool = False
    backed_up: bool = False
    attributes: int | None = None

    @property
    def output(self) -> pathlib.Path:
        return self.directory / "output"

    @property
    def backup(self) -> pathlib.Path:
        return self.directory / "original"


class Transaction:
    """
    Replace several files all-or-nothing.

    stage() writes each new content to a temporary file next to its
    original, with the original's metadata. commit() checks that no
    original changed meanwhile, then renames the new files into place,
    keeping a hard link (or a copy) of each original so that a failure
    part way puts every file back.
    Leaving the with block without commit() discards what was staged.

    A crash during commit() can still leave some files replaced; their
    originals stay in the `.NAME.git-age-*` directories next to them.
    """

    def __init__(self) -> None:
        self._staged: list[_StagedReplacement] = []

    def __enter__(self) -> Transaction:
        return self

    def __exit__(self, *_: object) -> None:
        for item in self._staged:
            if not item.keep:
                shutil.rmtree(item.directory, ignore_errors=True)
        self._staged = []

    def stage(self, path: pathlib.Path, produce: Callable[[], bytes]) -> None:
        """Stage the content produce() returns, which may read path, as path's new content."""

        signature = _file_signature(path)
        content = produce()
        directory = pathlib.Path(tempfile.mkdtemp(dir=path.parent, prefix=_temporary_prefix(path)))
        item = _StagedReplacement(path, directory, signature)
        self._staged.append(item)
        _write_output(item.output, content, source=path)

    def commit(self) -> None:
        for item in self._staged:
            if _file_signature(item.path) != item.signature:
                raise RuntimeError(f"{item.path} changed while git-age ran; no file was changed")

        try:
            for item in self._staged:
                item.attributes = _make_replaceable(item.path)
                try:
                    os.link(item.path, item.backup)
                except OSError:
                    shutil.copyfile(item.path, item.backup)
                    _preserve_metadata(item.path, item.backup)
                item.backed_up = True
                _replace_file(item.output, item.path)
        except BaseException:
            self._roll_back()
            raise
        finally:
            self._restore_attributes()

        for directory in {item.path.parent for item in self._staged}:
            _fsync_directory(directory)

    def _roll_back(self) -> None:
        for item in reversed(self._staged):
            if not item.backed_up:
                continue
            try:
                # Not replaced: the replacement failed before changing it.
                if item.path.exists() and os.path.samefile(item.path, item.backup):
                    continue
                _replace_file(item.backup, item.path)
            except OSError as exc:
                item.keep = True
                _err(
                    f"git-age: cannot restore {item.path}: {exc}",
                    f"  its original content is in {item.backup}",
                )

    def _restore_attributes(self) -> None:
        for item in self._staged:
            if item.attributes is None:
                continue
            try:
                # The archive attribute tells backup tools the file changed.
                _set_file_attributes(item.path, item.attributes | stat.FILE_ATTRIBUTE_ARCHIVE)
            except OSError as exc:
                _err(f"git-age: cannot restore the attributes of {item.path}: {exc}")


