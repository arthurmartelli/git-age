            "rewrite every local branch and tag, encrypting protected files "
            "to the current recipients"
        ),
    )
    audit_parser.add_argument(
        "--plaintext-only",
        action="store_true",
        help="with --rekey: only encrypt plaintext, keep existing ciphertext",
    )
    audit_parser.add_argument(
        "--keep-undecryptable",
        action="store_true",
        help="with --rekey: keep ciphertext you cannot decrypt instead of stopping",
    )
    audit_parser.add_argument(
        "--yes", action="store_true", help="with --rekey: rewrite without asking"
