def _err(*lines: str) -> None:
    """Print lines to stderr, after anything already written to stdout."""

    sys.stdout.flush()
    for line in lines:
        print(line, file=sys.stderr)


def _indented(items: Iterable[object]) -> list[str]:
    return [f"  {item}" for item in items]


def _shell_paths(paths: list[pathlib.PurePosixPath]) -> str:
    return " ".join(shlex.quote(path.as_posix()) for path in paths)


def _display_path(config: Config, path: pathlib.Path) -> pathlib.PurePosixPath:
    """path relative to -C if inside it, with forward slashes as Git shows paths."""

    try:
        path = path.relative_to(config.root)
    except ValueError:
        pass
    return pathlib.PurePosixPath(path.as_posix())


def print_status(config: Config, protected_files: list[ProtectedFile]) -> None:
    for protected_file in protected_files:
        display_path = _display_path(config, protected_file.path)
        note = " (no access)" if _no_access(config, protected_file) else ""
        print(f"{protected_file.state.value.upper():<10} {display_path}{note}")

        if config.options.verbose:
            rule = protected_file.protection.rule
            rule_file = _display_path(config, protected_file.protection.rule_file)
            print(f"           matched {rule_file}:{rule.line_number}: {rule.pattern}")
            print(f"           encrypted to {config.age_for(protected_file.path).target}")


def _no_access(config: Config, protected_file: ProtectedFile) -> bool:
    """Whether a file is locked and .gitage does not encrypt it to the user."""

    return protected_file.state is FileState.LOCKED and not config.encrypted_to_user(
        protected_file.path
    )


def _quote_porcelain_path(path: str) -> str:
    """
    Quote a path the way Git does with core.quotePath=false.
    """

    escapes = {'"': '\\"', "\\": "\\\\", "\t": "\\t", "\n": "\\n"}
    quoted = "".join(
        escapes.get(char)
        or (f"\\{ord(char):03o}" if ord(char) < 0x20 or ord(char) == 0x7F else char)
        for char in path
    )
    return path if quoted == path else f'"{quoted}"'


def print_porcelain_status(
    config: Config, protected_files: list[ProtectedFile], stale: list[pathlib.Path]
) -> None:
    """
    One record per protected file: `XY PATH` (see PORCELAIN STATUS).
    """

    stale_paths = set(stale)
    codes = {FileState.LOCKED: "L", FileState.UNLOCKED: "U", FileState.UNKNOWN: "?"}
    null_terminated = config.options.null_terminated
    terminator = "\0" if null_terminated else "\n"

    for protected_file in protected_files:
        path = str(_display_path(config, protected_file.path))
        if not null_terminated:
            path = _quote_porcelain_path(path)
        if protected_file.path in stale_paths:
            flag = "S"
        elif _no_access(config, protected_file):
            flag = "N"
        else:
            flag = "."
        sys.stdout.write(f"{codes[protected_file.state]}{flag} {path}{terminator}")


def _print_plaintext_staged(staged_files: list[StagedFile]) -> None:
    _err(
        "git-age: protected files are staged as plaintext:",
        "",
        *_indented(staged.path for staged in staged_files),
        "",
    )


# ---------------------------------------------------------------------------
# Git hook installation / policy
# ---------------------------------------------------------------------------


HOOK_PROGRAM_COMMAND = ["git", "age"]


def _hook_marker(event: str) -> str:
    return f"# git-age managed {event} hook"


def _render_hook(event: str, comment: str) -> str:
    """
    Render a tiny hook that delegates to `git age hook <event>`.

    Policy never lives in the hook itself, so upgrading git-age applies to
    hooks that are already installed.
    """

    command = " ".join(shlex.quote(part) for part in [*HOOK_PROGRAM_COMMAND, "hook", event])
    if event in ARGUMENT_HOOK_EVENTS:
        command += ' "$@"'
    comment_lines = "".join(f"# {line}\n" for line in comment.splitlines())
    return f"#!/bin/sh\n{_hook_marker(event)}\n#\n{comment_lines}exec {command}\n"


def _managed_hooks(diff: bool) -> list[tuple[str, str]]:
    """(event, script) for every hook `install` manages."""

    hooks = [
        (
            "pre-commit",
            "Do not put policy logic here. The hook delegates back to git-age so\n"
            "upgrades to the Python implementation automatically apply.\n"
            f"Policy: {HOOK_MODE_ENV}, then git config {HOOK_MODE_CONFIG}.",
        ),
        # Installed even when unlocking is disabled, so that
        # GIT_AGE_UNLOCK_AFTER_COMMIT=1 works for a single commit.
        (
            "post-commit",
            "Do not put policy logic here. The hook delegates back to git-age so\n"
            "environment overrides and future implementation changes stay in one\n"
            "place.\n"
            f"Policy: {UNLOCK_AFTER_COMMIT_ENV}, then git config "
            f"{UNLOCK_AFTER_COMMIT_CONFIG}.",
        ),
        (
            "pre-push",
            "Refuses to push commits that hold protected plaintext or private\n"
            "keys, whichever way they were made.\n"
            f"Override: {ALLOW_PLAINTEXT_PUSH_ENV}=1 git push, or git push --no-verify.",
        ),
    ]
    # post-merge also warns about merged [recipients] changes, so it stays
    # without the Git attributes too.
    hooks.extend(
        (
            event,
            "Keeps the generated git-age block in info/attributes in sync with\n"
            ".gitage after the working tree changes. Never fails the Git command.",
        )
        for event in SYNC_HOOK_EVENTS
        if diff or event == "post-merge"
    )
    return [(event, _render_hook(event, comment)) for event, comment in hooks]


def _parse_hook_mode(source: str, value: str) -> HookMode:
    try:
        return HookMode(value)
    except ValueError as exc:
        valid = ", ".join(mode.value for mode in HookMode)
        raise RuntimeError(f"invalid {source}={value!r}; expected one of: {valid}") from exc


def _effective_hook_mode(root: pathlib.Path) -> HookMode:
    """
    Resolve the pre-commit policy:

        1. GIT_AGE_HOOK_MODE
        2. git config age.hookMode
        3. interactive
    """

    override = os.environ.get(HOOK_MODE_ENV)
    if override:
        return _parse_hook_mode(HOOK_MODE_ENV, override)

    configured = _git_config_get(root, HOOK_MODE_CONFIG)
    if configured:
        return _parse_hook_mode(HOOK_MODE_CONFIG, configured)

    return HookMode.INTERACTIVE


def _parse_bool_env(name: str, value: str) -> bool:
    """
    Parse a conventional boolean environment variable.

    Accept a few common spellings so shell usage is convenient while still
    rejecting typos instead of silently choosing a policy.
    """

    normalized = value.strip().lower()

    if normalized in {"1", "true", "yes", "on"}:
        return True
    if normalized in {"0", "false", "no", "off"}:
        return False

    raise RuntimeError(
        f"invalid {name}={value!r}; expected one of: 1, 0, true, false, yes, no, on, off"
    )


def _effective_unlock_after_commit(root: pathlib.Path) -> bool:
    """
    Resolve post-commit unlock:

        1. GIT_AGE_UNLOCK_AFTER_COMMIT
        2. git config age.unlockAfterCommit
        3. disabled
    """

    override = os.environ.get(UNLOCK_AFTER_COMMIT_ENV)
    if override is not None:
        return _parse_bool_env(UNLOCK_AFTER_COMMIT_ENV, override)

    configured = _git_config_get(root, UNLOCK_AFTER_COMMIT_CONFIG, value_type="bool")
    if configured is not None:
        return configured == "true"

    return False


def _open_interactive_tty() -> tuple[TextIO, TextIO] | None:
    """
    Open the controlling terminal for an interactive Git hook prompt.

    Git hooks commonly receive stdin as a non-interactive stream, so input()
    or sys.stdin is not reliable here. Some Python/platform combinations
    cannot open a terminal character device with "r+" because it is
    non-seekable, so use separate read and write handles.
    """

    try:
        reader = open("/dev/tty", encoding="utf-8")
    except OSError:
        return None
    try:
        return reader, open("/dev/tty", "w", encoding="utf-8", buffering=1)
    except OSError:
        reader.close()
        return None


def _prompt_hook_choice() -> HookChoice | None:
    """
    Prompt for what to do when protected plaintext is staged.

    Returns None when there genuinely is no usable interactive terminal.
    Abort remains the default answer.
    """

    tty = _open_interactive_tty()

    if tty is None:
        return None

    tty_in, tty_out = tty

    try:
        while True:
            tty_out.write("What would you like to do?\n\n")
            tty_out.write("  [e] Encrypt staged protected files and continue\n")
            tty_out.write("  [a] Abort the commit\n")
            tty_out.write("  [c] Commit them as plaintext anyway\n\n")
            tty_out.write("Choice [a]: ")
            tty_out.flush()

            answer = tty_in.readline().strip().lower()
            if answer in {"", "a", "abort"}:
                return HookChoice.ABORT
            if answer in {"e", "encrypt"}:
                return HookChoice.ENCRYPT
            if answer in {"c", "commit"}:
                tty_out.write("\nWARNING: protected plaintext will enter Git history.\n")
                tty_out.write('Type "commit" to continue: ')
                tty_out.flush()

                confirmation = tty_in.readline().strip()
                if confirmation == "commit":
                    return HookChoice.COMMIT

                tty_out.write("Plaintext commit not confirmed; aborting.\n")
                tty_out.flush()
                return HookChoice.ABORT

            tty_out.write("Please choose e, a, or c.\n\n")
            tty_out.flush()
    finally:
        tty_in.close()
        tty_out.close()


# ---------------------------------------------------------------------------
# Readable diffs: textconv driver and generated attributes
# ---------------------------------------------------------------------------


def _escape_glob(text: str) -> str:
    return re.sub(r"([\\*?\[])", r"\\\1", text)


def _quote_attribute_pattern(pattern: str) -> str:
    """C-quote patterns that Git would otherwise split at whitespace."""

    if not any(char.isspace() for char in pattern) and not pattern.startswith('"'):
        return pattern
    escaped = pattern.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def _attribute_patterns(prefix: str, rule: Rule) -> list[str]:
    """
    Translate one positive [files] rule into gitattributes patterns.

    The result may match MORE paths than the rule, never fewer: textconv
    passes non-age content through unchanged, so over-matching is harmless.
    Two differences from gitignore matter:

      * a pattern matching a directory does not match the files inside it,
        so every pattern also gets a `/**` form;
      * patterns are relative to the attributes file (the Git root), so
        rules from a nested .gitage get its directory as a prefix.
    """

    pattern = rule.glob
    if not pattern:
        return []

    base = f"{_escape_glob(prefix)}/" if prefix else ""
    if not rule.anchored and "/" not in pattern:
        head = f"/{base}**/{pattern}"
        file_pattern = head if base else pattern
    else:
        head = f"/{base}{pattern}"
        file_pattern = head

    if head.endswith("/**"):
        patterns = [head]
    elif rule.directory_only:
        patterns = [f"{head}/**"]
    else:
        patterns = [file_pattern, f"{head}/**"]

    return [_quote_attribute_pattern(item) for item in patterns]


def _working_rule_sets(git: Git) -> list[RuleSet]:
    """Every .gitage in the working tree, whatever -C points at."""

    return [parse_gitage_file(path) for path in find_gitage_files(git.root, in_git=True)]


def _render_attributes_block(git: Git, rule_sets: list[RuleSet]) -> str:
    lines = [ATTRIBUTES_BEGIN]
    seen: set[str] = set()
    # All always: Git ignores a diff or filter driver that is not configured,
    # and merges as text without a configured merge driver.
    attributes = f"diff={DIFF_DRIVER} filter={FILTER_DRIVER} merge={MERGE_DRIVER}"

    for rule_set in rule_sets:
        prefix = rule_set.root.relative_to(git.root).as_posix()
        if prefix == ".":
            prefix = ""
        for rule in rule_set.rules:
            # gitattributes has no negation. Dropping it over-matches,
            # which textconv, the clean filter and the merge driver tolerate.
            if rule.negate:
                continue
            for pattern in _attribute_patterns(prefix, rule):
                if pattern not in seen:
                    seen.add(pattern)
                    lines.append(f"{pattern} {attributes}")

    lines.append(ATTRIBUTES_END)
    return "\n".join(lines) + "\n"


def _split_attributes_block(text: str) -> tuple[str, str, bool]:
    """Return (before, after, found) around the managed block."""

    lines = text.splitlines(keepends=True)
    try:
        begin = next(i for i, line in enumerate(lines) if line.rstrip("\n") == ATTRIBUTES_BEGIN)
    except StopIteration:
        return text, "", False

    end = next(
        (i for i in range(begin + 1, len(lines)) if lines[i].rstrip("\n") == ATTRIBUTES_END),
        len(lines) - 1,
    )
    return "".join(lines[:begin]), "".join(lines[end + 1 :]), True


def _update_attributes_block(
    git: Git, *, install: bool, remove: bool = False
) -> pathlib.Path | None:
    """
    Write, refresh or remove the managed diff=age block in info/attributes.

    Without `install`, an existing block is refreshed and a missing one is
    left missing, so repositories that never ran `git-age install` are not
    touched. Returns the attributes file when it was changed.
    """

    path = git.path("info/attributes")
    existing = path.read_text(encoding="utf-8") if path.is_file() else ""
    before, after, found = _split_attributes_block(existing)

    if remove:
        if not found:
            return None
        updated = before + after
    else:
        if not found and not install:
            return None
        if before and not before.endswith("\n"):
            before += "\n"
        block = _render_attributes_block(git, _working_rule_sets(git))
        updated = before + block + after

    if updated == existing:
        return None
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
    _atomic_write(path, updated.encode("utf-8"), mode=mode)
    return path


def _refresh_diff_attributes(git: Git | None, *, verbose: bool = False) -> None:
    """
    Keep an installed diff=age block in sync with .gitage, best effort.

    Readable diffs are a convenience: a failure here only warns.
    """

    if git is None:
        return
    try:
        changed = _update_attributes_block(git, install=False)
    except Exception as exc:
        print(f"git-age: warning: could not refresh diff attributes: {exc}", file=sys.stderr)
        return
    if changed is not None and verbose:
        print(f"git-age: refreshed diff attributes: {changed}", file=sys.stderr)


def _textconv_placeholder(ciphertext: bytes, reason: str) -> bytes:
    digest = hashlib.sha256(ciphertext).hexdigest()
    return f"[git-age: encrypted, {reason}; sha256 {digest}]\n".encode()


def _textconv_bytes(age: Age, content: bytes) -> bytes:
    """
    Convert one blob for display. Never raises: a failing textconv would
    make Git abort the whole diff, so problems become a placeholder line
    that still changes whenever the ciphertext changes.
    """

    if detect_content_state(content) is FileState.LOCKED:
        if not age.identities:
            return _textconv_placeholder(content, "no identity configured")
        try:
            age.check_identities()
            plaintext = age.decrypt(content)
        except RuntimeError as exc:
            first_line = str(exc).splitlines()[0]
            return _textconv_placeholder(content, first_line)
        if plaintext is None:
            return _textconv_placeholder(
                content, f"cannot decrypt with {_format_identities(age.identities)}"
            )
        content = plaintext

    # Textconv output is always diffed as text, so keep binary out of it.
    if b"\0" in content[:BINARY_SNIFF_BYTES]:
        digest = hashlib.sha256(content).hexdigest()
        return f"[git-age: binary content, {len(content)} bytes; sha256 {digest}]\n".encode()

    return content


def run_textconv(config: Config) -> int:
    content = resolve_path(config.root, config.options.file).read_bytes()
    sys.stdout.buffer.write(_textconv_bytes(config.age, content))
    sys.stdout.buffer.flush()
    return 0


def _clean_bytes(config: Config, git_path: pathlib.PurePosixPath, content: bytes) -> bytes:
    """
    What Git stores for a working-tree file.

    Plaintext that `lock` would encrypt to the ciphertext in the index (or
    HEAD) becomes that ciphertext, so an unlocked, unchanged file equals its
    blob. Anything else passes through: changed plaintext still shows as
    modified, and the pre-commit hook still encrypts it, also to changed
    [recipients]. This never raises: the filter is required, so a failure
    would break every `git status`.

    Except for a resolved conflict of encrypted versions: that is encrypted,
    because `git rebase --continue` and `git cherry-pick --continue` commit
    without the pre-commit hook. Failing to encrypt it raises, so that Git
    refuses to stage the plaintext.
    """

    if detect_content_state(content) is not FileState.UNLOCKED:
        return content
    try:
        git = Git.at(config.root)
        conflicted = _conflicted_ciphertext(git, git_path)
    except Exception:
        return content
    if conflicted:
        # Encrypting needs every [recipients] list, for the trust check.
        repository = Repository.from_working_tree(git.root)
        if repository.protection(git_path) is None:
            return content
        resolve_recipients(config, repository)
        age = config.age_for(git.absolute(git_path))
        reused = age.reusable_ciphertext(git, git_path, content)
        if reused is not None:
            return reused
        check_recipient_trust(config)
        age.prepare()
        return age.encrypt(content)

    if not config.age.identities:
        return content
    try:
        # Only the .gitage files above the path can protect it or add
        # recipients; the attributes over-match, and an unprotected file
        # must stay as it is.
        rule_sets = [parse_gitage_file(path) for path in _rule_files_above(git.root, git_path)]
        repository = Repository.build(git.root, git, rule_sets)
        if repository.protection(git_path) is None:
            return content
        resolve_recipients(config, repository)
        age = config.age_for(git.absolute(git_path))
        reused = age.reusable_ciphertext(git, git_path, content)
    except Exception:
        return content
    return content if reused is None else reused


def _conflicted_ciphertext(git: Git, git_path: pathlib.PurePosixPath) -> bool:
    """Whether path is unmerged in the index, and ours or theirs is encrypted."""

    if git.blob(f":0:{git_path.as_posix()}") is not None:
        return False
    sides = (git.blob(f":{stage}:{git_path.as_posix()}") for stage in (2, 3))
    return any(
        side is not None and detect_content_state(side) is FileState.LOCKED for side in sides
    )


def run_clean(config: Config) -> int:
    content = sys.stdin.buffer.read()
    try:
        cleaned = _clean_bytes(config, config.options.file, content)
    except Exception as exc:
        first_line = str(exc).splitlines()[0] if str(exc) else type(exc).__name__
        _err(
            f"git-age: cannot encrypt resolved conflict {config.options.file}: {first_line}",
            "  Refusing to stage it as plaintext; fix the problem, then `git add` it again.",
        )
        return 1
    sys.stdout.buffer.write(cleaned)
    sys.stdout.buffer.flush()
    return 0


class MergeError(Exception):
    """The merge driver cannot merge a file; Git keeps our version."""


def _merge_plaintexts(
    git: Git, base: bytes, ours: bytes, theirs: bytes, marker_size: int
) -> tuple[bytes, bool]:
    """
    Three-way merge with `git merge-file`, which honors merge.conflictStyle.
    Returns the result and whether it is clean.

    The inputs are plaintext, so they go to a private directory inside the
    Git directory rather than the shared temporary directory.
    """

    with tempfile.TemporaryDirectory(prefix="git-age-merge-", dir=git.path(".")) as directory:
        names = []
        for name, content in (("ours", ours), ("base", base), ("theirs", theirs)):
            path = pathlib.Path(directory, name)
            path.write_bytes(content)
            names.append(os.fspath(path))
        result = git.run(
            [
                "merge-file",
                "--stdout",
                f"--marker-size={marker_size}",
                *("-L", "ours", "-L", "base", "-L", "theirs"),
                *names,
            ],
            check=False,
        )
    # git merge-file exits with the number of conflicts, capped at 127, and
    # negative, i.e. 255, on error.
    if not 0 <= result.returncode <= 127:
        message = result.stderr.decode(errors="replace").strip()
        raise MergeError(f"git merge-file failed: {message}" if message else "git merge-file failed")
    return result.stdout, result.returncode == 0


def _merge_bytes(
    config: Config, git: Git, git_path: pathlib.PurePosixPath, versions: list[bytes]
) -> tuple[bytes, bool]:
    """
    Merge base, ours and theirs (in that order) of a protected file. Returns
    what Git should record, and whether it is clean.

    A clean result is encrypted, since Git commits it as it is, and `git
    merge` runs no pre-commit hook. Where both sides made the same change,
    their ciphertext is reused. A conflict is left as plaintext with
    conflict markers, to resolve like any unlocked file; the clean filter
    encrypts it again on `git add`.
    """

    locked = [detect_content_state(version) is FileState.LOCKED for version in versions]
    plaintexts = list(versions)
    if any(locked):
        age = config.age
        age.require_identities()
        for index, version in enumerate(versions):
            if locked[index]:
                plaintext = age.decrypt(version)
                if plaintext is None:
                    raise MergeError(f"cannot decrypt with {_format_identities(age.identities)}")
                plaintexts[index] = plaintext

    if any(b"\0" in plaintext[:BINARY_SNIFF_BYTES] for plaintext in plaintexts):
        raise MergeError("binary content")

    merged, clean = _merge_plaintexts(git, *plaintexts, config.options.marker_size)
    # Unencrypted history, or a path the attributes over-match: a text merge.
    if not clean or not any(locked):
        return merged, clean

    for index in (1, 2):
        if locked[index] and plaintexts[index] == merged:
            return versions[index], True

    repository = Repository.from_working_tree(git.root)
    if repository.protection(git_path) is None:
        raise MergeError(f"not protected by {RULE_FILE_NAME}, but encrypted")
    resolve_recipients(config, repository)
    check_recipient_trust(config)
    age = config.age_for(git.absolute(git_path))
    age.prepare()
    return age.encrypt(merged), True


def run_merge(config: Config) -> int:
    """
    Git merge driver: merge %O, %A and %B into %A, exit 0 when clean.

    Whatever goes wrong, %A keeps our version and the merge conflicts, like
    Git's own merge of binary files.
    """

    options = config.options
    paths = [resolve_path(config.root, path) for path in (options.base, options.ours, options.theirs)]
    try:
        git = Git.at(config.root)
        merged, clean = _merge_bytes(
            config, git, options.path, [path.read_bytes() for path in paths]
        )
    except Exception as exc:
        first_line = str(exc).splitlines()[0] if str(exc) else type(exc).__name__
        _err(f"git-age: cannot merge {options.path}: {first_line}; keeping our version")
        return 1

    paths[1].write_bytes(merged)
    if not clean:
        _err(
            f"git-age: {options.path} has conflicts and is now UNLOCKED in the working tree.",
            "  Resolve them, then `git add` encrypts it again (needs the clean filter).",
        )
    return 0 if clean else 1


def _configure_merge_driver(git: Git, enable: bool) -> None:
    command = " ".join(shlex.quote(part) for part in [*HOOK_PROGRAM_COMMAND, "merge"])
    git.config_set(MERGE_NAME_CONFIG, "git-age: merge decrypted" if enable else None)
    git.config_set(
        MERGE_DRIVER_CONFIG, f"{command} --path %P --marker-size %L %O %A %B" if enable else None
    )


def _configure_filter(git: Git, enable: bool) -> None:
    command = " ".join(shlex.quote(part) for part in [*HOOK_PROGRAM_COMMAND, "clean"])
    git.config_set(FILTER_CLEAN_CONFIG, f"{command} %f" if enable else None)
    # Required, so that Git refuses `git add` when a resolved conflict cannot
    # be encrypted, instead of storing the plaintext unchanged. A required
    # filter needs a smudge command too, or every checkout fails.
    git.config_set(FILTER_SMUDGE_CONFIG, "cat" if enable else None)
    git.config_set(FILTER_REQUIRED_CONFIG, "true" if enable else None)


def _configure_diff_driver(git: Git, enable: bool) -> None:
    command = " ".join(shlex.quote(part) for part in [*HOOK_PROGRAM_COMMAND, "textconv"])
    git.config_set(DIFF_TEXTCONV_CONFIG, command if enable else None)


