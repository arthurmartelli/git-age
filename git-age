# Git index inspection
# ---------------------------------------------------------------------------


def resolve_staged_protected_files(repository: Repository) -> list[StagedFile]:
    """
    Resolve protected *staged* regular files using the repository's rules,
    which callers load from the index (Repository.from_index).
    """

    git = repository.git
    assert git is not None
    index = git.index()
    staged: list[StagedFile] = []

    for path in git.staged_changed_paths():
        entry = index.get(path)
        if entry is not None and entry.is_regular and repository.protection(path) is not None:
            staged.append(StagedFile(entry, git.read_blob(entry.oid)))

    return staged


def resolve_staged_private_keys(repository: Repository) -> list[pathlib.PurePosixPath]:
    """
    Staged files that would commit a private age key in plaintext:

      * any `.gitage.key`, whatever its content, and
      * any other file containing AGE-SECRET-KEY- that is not protected by
        .gitage rules. Protected files go through the normal hook policy
        instead, which may encrypt them.
    """

    git = repository.git
    assert git is not None
    changed = git.staged_changed_paths()
    if not changed:
        return []

    result = git.run(
        ["grep", "--cached", "--full-name", "-l", "-z", "-F", "-e", AGE_SECRET_KEY_MARKER],
        error="could not scan staged files for private keys",
        allowed=(0, 1),
    )
    containing_keys = {
        pathlib.PurePosixPath(os.fsdecode(raw)) for raw in result.stdout.split(b"\0") if raw
    }

    leaks: list[pathlib.PurePosixPath] = []
    for path in changed:
        if path.name == LOCAL_KEY_FILE_NAME:
            leaks.append(path)
        elif path in containing_keys and repository.protection(path) is None:
            leaks.append(path)
    return leaks


def _print_private_keys_staged(leaks: list[pathlib.PurePosixPath]) -> None:
    _err(
        "git-age: refusing to commit private age keys:",
        "",
        *_indented(leaks),
        "",
        "Private keys must never enter Git history. Unstage them with:",
        "",
        f"  git restore --staged -- {_shell_paths(leaks)}",
        "",
        "If you really want to commit them, run:",
        "",
        f"  {ALLOW_PRIVATE_KEYS_ENV}=1 git commit ...",
        "",
    )


def _print_removed_rule_files(removed: list[pathlib.PurePosixPath]) -> None:
    _err(
        f"git-age: refusing to commit the removal of {RULE_FILE_NAME} files:",
        "",
        *_indented(removed),
        "",
        "Their rules would stop protecting files, which could then be committed",
        "as plaintext. Restore them with:",
        "",
        f"  git restore --staged --worktree -- {_shell_paths(removed)}",
        "",
        "To stop using git-age in this repository, run `git-age uninstall` first.",
        "To commit the removal anyway and keep git-age installed, run:",
        "",
        f"  {ALLOW_REMOVE_ENV}=1 git commit ...",
        "",
    )


def _rule_removal_refused(git: Git) -> bool:
    """Report removed .gitage files; True when the commit must be aborted."""

    removed = Repository.removed_rule_files(git)
    if not removed:
        return False
    if not _env_flag(ALLOW_REMOVE_ENV):
        _print_removed_rule_files(removed)
        _err("git-age: commit aborted.")
        return True
    _err(f"git-age: removing {RULE_FILE_NAME} files by explicit choice ({ALLOW_REMOVE_ENV}).")
    return False


def encrypt_staged_files(
    config: Config, repository: Repository, staged_files: list[StagedFile]
) -> list[pathlib.PurePosixPath]:
    """
    Encrypt exact staged blobs and update the index directly.

    Returns the working-tree files that were left unlocked.
    """

    plaintext_files = [staged for staged in staged_files if staged.state is FileState.UNLOCKED]
    if not plaintext_files:
        return []

    git = repository.git
    assert git is not None
    ages = [config.age_for(git.absolute(staged.path)) for staged in plaintext_files]

    for age in ages:
        age.prepare()

    # Encrypt every staged blob before the index changes, so a failure on
    # any file leaves it untouched.
    encrypted = [
        (staged, age.encrypt_reusing(git, staged.path, staged.content))
        for staged, age in zip(plaintext_files, ages)
    ]
    git.stage([(staged.entry, ciphertext) for staged, ciphertext in encrypted])

    left_unchanged: list[pathlib.PurePosixPath] = []

    # Keep the working tree in sync only when doing so cannot destroy unstaged
    # work: the file must still equal the exact plaintext blob we encrypted.
    for staged, ciphertext in encrypted:
        working_path = git.absolute(staged.path)

        try:
            if working_path.is_symlink() or not working_path.is_file():
                left_unchanged.append(staged.path)
                continue
            current = working_path.read_bytes()
        except OSError:
            left_unchanged.append(staged.path)
            continue

        if current != staged.content:
            left_unchanged.append(staged.path)
            continue

        _atomic_write(working_path, ciphertext)

    return left_unchanged


