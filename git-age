# ---------------------------------------------------------------------------
# Dispatcher / entrypoint
# ---------------------------------------------------------------------------


def run_hook(config: Config) -> int:
    git = Git.at(config.root)

    # A staged or committed .gitage may differ from the attributes.
    _refresh_diff_attributes(git, verbose=config.options.verbose)

    match config.options.hook_event:
        case "pre-commit":
            # Removing a .gitage that HEAD has would silently unprotect its
            # files, so it is refused even when no .gitage is left staged.
            if _rule_removal_refused(git):
                return 1
            # Without a staged .gitage, e.g. on an old or orphan branch or
            # with a global core.hooksPath, nothing is protected and the
            # hook stays out of the way. A .gitage.key is still refused; the
            # AGE-SECRET-KEY- scan is not, since without rules it would
            # refuse any file that merely mentions the marker.
            if not Repository.staged_rule_files(git):
                key_files = [
                    path for path in git.staged_changed_paths() if path.name == LOCAL_KEY_FILE_NAME
                ]
                return 1 if _private_keys_refused(key_files) else 0
            # Judge the commit by its own staged .gitage files.
            repository = Repository.from_index(git)
            resolve_recipients(config, repository)
            return run_pre_commit_hook(config, repository)
        case "post-commit":
            if not find_gitage_files(git.root, in_git=True):
                return 0
            repository = Repository.from_working_tree(git.root)
            resolve_recipients(config, repository)
            return run_post_commit_hook(config, repository)
        case "pre-push":
            return run_pre_push_hook(config, git, sys.stdin)
        case event if event in SYNC_HOOK_EVENTS:
            # These must never fail, since git checkout/merge/rebase report
            # hook errors. Only post-merge knows the range that came in.
            if event == "post-merge":
                try:
                    warn_merged_recipient_changes(git)
                except Exception as exc:
                    _err(f"git-age: could not check [{RECIPIENTS_SECTION}] changes: {exc}")
            return 0

    raise RuntimeError(f"unsupported hook event: {config.options.hook_event}")


def run(config: Config) -> int:
    match config.command:
        case "keygen":
            return run_keygen(config)
        case "install":
            return run_install(config)
        case "uninstall":
            return run_uninstall(config)
        case "textconv":
            return run_textconv(config)
        case "clean":
            return run_clean(config)
        case "merge":
            return run_merge(config)
        case "trust":
            return run_trust(config)
        case "audit":
            return run_audit(config)
        case "hook":
            return run_hook(config)
        case "help":
            return run_help(config)
        case "completion":
            return run_completion(config)
        case "check" if config.options.cached:
            return run_check_cached(config, Git.at(config.root))
        case "check":
            return run_check(config, Repository.from_working_tree(config.root))

    repository = Repository.from_working_tree(config.root)
    # status stays read-only.
    if not config.options.dry_run and config.command != "status":
        _refresh_diff_attributes(repository.git, verbose=config.options.verbose)

    resolve_recipients(config, repository)
    protected_files = repository.protected_files()
    if config.command != "edit":
        protected_files = select_protected_files(
            config, repository, protected_files, config.options.paths
        )

    match config.command:
        case "edit":
            return run_edit(config, repository, protected_files)
        case "lock":
            return run_lock(config, repository, protected_files)
        case "rekey":
            return run_rekey(config, protected_files)
        case "unlock":
            return run_unlock(config, protected_files)
        case "status":
            return run_status(config, repository, protected_files)

    raise AssertionError(f"unhandled command: {config.command}")


def main(argv: list[str] | None = None) -> int:
    if _WINDOWS:
        # Print LF line endings, as Git does, rather than CRLF.
        for stream in (sys.stdout, sys.stderr):
            if isinstance(stream, io.TextIOWrapper):
                stream.reconfigure(newline="\n")
    try:
        config = parse_args(argv)
        return run(config)
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130
    except BrokenPipeError:
        # Whoever read our output stopped, e.g. a shell prompt's timed-out
        # `git status` or a closed pager. Point stdout at /dev/null so the
        # flush at exit cannot fail again, and exit like SIGPIPE would.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        return 128 + 13
    except Exception as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
