class IndexEntry(NamedTuple):
    """A stage-0 entry in Git's index; path is relative to the Git root."""

    path: pathlib.PurePosixPath
    mode: str
    oid: str

    @property
    def is_regular(self) -> bool:
        return self.mode in REGULAR_FILE_MODES


class HookChoice(enum.Enum):
    """What to do when the interactive pre-commit hook finds staged plaintext."""

    ENCRYPT = "e"
    ABORT = "a"
    COMMIT = "c"


class Baseline(NamedTuple):
    """
    The newest revision whose ciphertext targets a different [recipients]
    list than the current one. A protected file whose ciphertext is
    unchanged since rev is still encrypted to that previous list.
    """

    rev: str
    changed_in: str | None

    @property
    def uncommitted(self) -> bool:
        return self.changed_in is None


@dataclass
class Rule:
    """One [files] entry, matched with gitignore semantics."""

    pattern: str
    negate: bool = False
    line_number: int = 0
    glob: str = field(init=False)
    anchored: bool = field(init=False)
    directory_only: bool = field(init=False)
    regex: re.Pattern[str] = field(init=False, repr=False)

    def __post_init__(self) -> None:
        glob = self.pattern
        self.directory_only = glob.endswith("/") and not glob.endswith("\\/")
        if self.directory_only:
            glob = glob[:-1]
        self.anchored = glob.startswith("/")
        if self.anchored:
            glob = glob[1:]
        self.glob = glob
        self.regex = _glob_to_regex(glob)

    def matches(self, relative_path: pathlib.PurePosixPath) -> bool:
        """Whether the rule matches a path relative to its .gitage's directory."""

        parts = relative_path.parts
        if not self.glob or not parts:
            return False

        if not self.anchored and "/" not in self.glob:
            candidates = parts[:-1] if self.directory_only else parts
            return any(self.regex.fullmatch(component) for component in candidates)

        stop = len(parts) - 1 if self.directory_only else len(parts)
        return any(self.regex.fullmatch("/".join(parts[:length])) for length in range(1, stop + 1))


@dataclass
class RuleSet:
