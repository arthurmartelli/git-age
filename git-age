def _fish_quote(text: str) -> str:
    return "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"


def _fish_value(value: str | list[str]) -> str:
    if isinstance(value, list):
        return f"-x -a {_fish_quote(' '.join(value))}"
    if value == "file":
        return "-r -F"
    if value == "dir":
        return "-x -a '(__fish_complete_directories (commandline -ct))'"
    return "-x"


def _fish_option(condition: str, option: CompletionOption) -> str:
    names = []
    for name in option.names:
        if name.startswith("--"):
            names.append(f"-l {name[2:]}")
        elif len(name) == 2:
            names.append(f"-s {name[1:]}")
        else:
            names.append(f"-o {name[1:]}")
    value = "" if option.value is None else " " + _fish_value(option.value)
    help = f" -d {_fish_quote(option.help)}" if option.help else ""
    return f"complete -c git-age -n {condition} {' '.join(names)}{value}{help}"


def fish_completion(parser: argparse.ArgumentParser) -> str:
    top, commands = completion_commands(parser)
    value_options = " ".join(
        name for option in top.options if option.value is not None for name in option.names
    )
    lines = ["complete -c git-age -f"]
    no_command = _fish_quote("not __git_age_command >/dev/null")
    lines.extend(_fish_option(no_command, option) for option in top.options)
    lines.extend(
        f"complete -c git-age -n {no_command} -a {command.name} -d {_fish_quote(command.help)}"
        for command in commands
    )
    for command in commands:
        lines.append("")
        condition = _fish_quote(f"__git_age_using {command.name}")
        lines.extend(_fish_option(condition, option) for option in command.options)
        if command.positionals and command.positionals[0].value != "none":
            value = command.positionals[0].value
            if isinstance(value, list):
                lines.append(
                    f"complete -c git-age -n {condition} -a {_fish_quote(' '.join(value))}"
                )
            else:
                lines.append(f"complete -c git-age -n {condition} -F")
    return FISH_COMPLETION.format(value_options=value_options, completions="\n".join(lines))


FISH_COMPLETION = r"""# fish completion for git-age, generated by `git-age completion fish`.
