@dataclass
class Age:
    """
    How to encrypt and decrypt: the recipients and the user's own keys.

    The identities decrypt, enable ciphertext reuse, and are the encryption
    target when no recipients are configured.
    """

    identities: list[pathlib.Path] = field(default_factory=list)
    recipients: list[str] = field(default_factory=list)
    source: str | None = None
    # An empty list targets the identities, so nested [recipients] that add to
    # it must keep encrypting to them.
    to_identities: bool = False
    baseline: Baseline | None = None
    reuse: bool = True
    # Shared with the copies scoped() makes, so each check and warning happens once.
    _plain: set[pathlib.Path] = field(default_factory=set, init=False, repr=False)
    _warned: set[frozenset[str]] = field(default_factory=set, init=False, repr=False)

    def scoped(self, extra: list[str], source: str | None, baseline: Baseline | None) -> Age:
        """A copy that also encrypts to extra, sharing this one's caches."""

        scoped = replace(
            self,
            recipients=list(dict.fromkeys(self.recipients + extra)),
            source=source,
            to_identities=self.to_identities or bool(extra and not self.recipients),
            baseline=baseline,
        )
        scoped._plain = self._plain
        scoped._warned = self._warned
        return scoped

    @property
    def target(self) -> str:
        """What files are encrypted to, for messages."""

        return self.source or _format_identities(self.identities)

    def _identity_arguments(self) -> list[str]:
        return [
            argument
            for identity in self.identities
            for argument in ("--identity", os.fspath(identity))
        ]

    def encrypt_command(self) -> list[str]:
        command = [_require_executable("age"), "--encrypt"]
        for recipient in self.recipients:
            command.extend(["--recipient", recipient])

        if self.recipients and not self.to_identities:
            return command

        if not self.identities:
            raise RuntimeError(
                "no encryption key configured\n\n"
                "Use one of:\n"
                f"  add a [{RECIPIENTS_SECTION}] section to {RULE_FILE_NAME}\n"
                f"  git config {KEY_FILE_CONFIG} /path/to/key\n"
                "  git-age lock -r age1...\n"
                "  git-age lock -i /path/to/key\n"
                "  git-age keygen"
            )
        self.check_identities()

        return command + self._identity_arguments()

    def own_recipients(self) -> frozenset[str] | None:
        """
        The recipients of the identities, as _recipient_key() compares them;
        None when one of them cannot be derived, see _public_keys().
        """

        self.check_identities()
        return _derive_recipients(tuple(self.identities))


    def prepare(self) -> None:
        """
        Fail before anything is touched if there is no key to encrypt to,
        and warn once if the user could not decrypt the result.
        """

        self.encrypt_command()
        self.warn_if_not_recipient()

    def check_identities(self) -> None:
        """Every identity must be usable: age aborts on the first one that is not."""

        for identity in self.identities:
            if not identity.is_file():
                raise RuntimeError(f"identity file not found: {identity}")
            self._ensure_plain(identity)

    def require_identities(self) -> list[pathlib.Path]:
        if not self.identities:
            raise RuntimeError(
                "no identity configured\n\n"
                "Use one of:\n"
                "  -i /path/to/key\n"
                f"  git config {KEY_FILE_CONFIG} /path/to/key\n"
                f"  export {KEY_FILE_ENV}=/path/to/key\n"
                f"  place {LOCAL_KEY_FILE_NAME} in the repository root"
            )
        self.check_identities()
        return self.identities

    def _ensure_plain(self, identity: pathlib.Path) -> None:
        """
        Refuse passphrase-protected identities up front.

        git-age deliberately supports only unencrypted key files. age would
        otherwise prompt once per age invocation, i.e. per file, with prompts
        hidden where stderr is discarded.
        """

        if identity in self._plain:
            return

        try:
            content = identity.read_bytes()
        except OSError as exc:
            raise RuntimeError(f"cannot read identity file {identity}: {exc}") from exc

        reason = _passphrase_protection(content)
        if reason is not None:
            raise RuntimeError(
                f"identity {identity} {reason}\n\n"
                "git-age only supports unencrypted key files. Protect the key with\n"
                "file permissions (chmod 600) and disk encryption instead, e.g.:\n"
                "  age -d -o key.txt key.age                  # age identity\n"
                "  ssh-keygen -p -N '' -f ~/.ssh/id_ed25519   # SSH key"
            )

        self._plain.add(identity)

    def warn_if_not_recipient(self) -> None:
        """
        Warn, once per recipient list, when encrypting to recipients that
        exclude the user's own key.

        Only age and SSH identities can be checked; plugin identities are
        skipped silently.
        """

        recipients = frozenset(self.recipients)
        if recipients in self._warned or self.to_identities or not self.recipients:
            return
        if not self.identities:
            return
        self._warned.add(recipients)

        for identity in self.identities:
            if identity.is_file():
                self._ensure_plain(identity)

        # Any one identity among the recipients is enough to unlock again. If
        # one cannot be checked (plugin), assume it might be.
        if any(not identity.is_file() for identity in self.identities):
            return
        own = self.own_recipients()

        if own and own.isdisjoint(_recipient_key(recipient) for recipient in self.recipients):
            if len(self.identities) == 1:
                subject = f"your identity {self.identities[0]} is not"
            else:
                listed = ", ".join(os.fspath(path) for path in self.identities)
                subject = f"none of your identities ({listed}) is"
            _err(
                f"git-age: warning: {subject} among the recipients from "
                f"{self.source}; you will not be able to unlock what "
                "you lock. Add a public key:",
                *_indented(sorted(own)),
            )

    def encrypt(self, plaintext: bytes) -> bytes:
        command = self.encrypt_command()
        try:
            result = subprocess.run(command, input=plaintext, stdout=subprocess.PIPE, check=True)
        except subprocess.CalledProcessError as exc:
            raise RuntimeError(f"age encryption failed with exit status {exc.returncode}") from exc
        return result.stdout

    def decrypt(self, ciphertext: bytes) -> bytes | None:
        """Decrypt ciphertext, returning None if none of the identities can open it."""

        result = subprocess.run(
            [_require_executable("age"), "--decrypt", *self._identity_arguments()],
            input=ciphertext,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return result.stdout if result.returncode == 0 else None

    def encrypt_reusing(
        self, git: Git | None, path: pathlib.PurePosixPath | None, plaintext: bytes
    ) -> bytes:
        """
        Encrypt plaintext, reusing Git's existing ciphertext when it is unchanged.

        age encryption is randomized, so encrypting the same plaintext twice
        yields different bytes and Git would see a spurious modification.

        See reusable_ciphertext() for when ciphertext is reused.
        """

        reused = self.reusable_ciphertext(git, path, plaintext)
        return reused if reused is not None else self.encrypt(plaintext)

    def reusable_ciphertext(
        self, git: Git | None, path: pathlib.PurePosixPath | None, plaintext: bytes
    ) -> bytes | None:
        """
        The ciphertext in the index or HEAD that decrypts to plaintext, if any.

        Reuse is skipped when the [recipients] list differs from HEAD, and any
        candidate identical to the file's ciphertext from before the last
        recipients change is ignored, because both are encrypted to an old list.
        """

        recipients_changed = self.baseline is not None and self.baseline.uncommitted
        if (
            not self.reuse
            or recipients_changed
            or git is None
            or path is None
            or not self.identities
            or not all(identity.is_file() for identity in self.identities)
        ):
            return None

        self.check_identities()
        stale = None
        if self.baseline is not None:
            stale = git.blob(f"{self.baseline.rev}:{path.as_posix()}")
        for ciphertext in _existing_ciphertexts(git, path):
            if ciphertext != stale and self.decrypt(ciphertext) == plaintext:
                return ciphertext
        return None


def _passphrase_protection(content: bytes) -> str | None:
    """
    Describe how a key file is passphrase-protected, or None if it is plain.

    Inspects the file instead of running age or ssh-keygen, which would
    prompt for the passphrase.
    """

    if content.startswith(AGE_HEADER) or content.startswith(AGE_ARMORED_HEADER):
        return "is an encrypted (passphrase-protected) age identity"

    text = content.decode("ascii", errors="replace")

    if (
        "-----BEGIN ENCRYPTED PRIVATE KEY-----" in text
        or "Proc-Type: 4,ENCRYPTED" in text
    ):
        return "is a passphrase-protected PEM private key"

    begin = "-----BEGIN OPENSSH PRIVATE KEY-----"
    end = "-----END OPENSSH PRIVATE KEY-----"
    if begin in text and end in text:
        body = text.split(begin, 1)[1].split(end, 1)[0]
        try:
            blob = base64.b64decode("".join(body.split()), validate=True)
        except (binascii.Error, ValueError):
            return None

        magic = b"openssh-key-v1\0"
        if not blob.startswith(magic) or len(blob) < len(magic) + 4:
            return None
        offset = len(magic)
        length = int.from_bytes(blob[offset : offset + 4], "big")
        cipher = blob[offset + 4 : offset + 4 + length]
        if cipher != b"none":
            return "is a passphrase-protected SSH private key"

    return None


def _recipient_key(recipient: str) -> str:
    """A recipient as compared with another: an SSH key without its comment."""

    fields = recipient.split()
    if fields and fields[0].startswith("ssh-"):
        return " ".join(fields[:2])
    return recipient.strip()


def _public_keys(identity: pathlib.Path) -> list[str] | None:
    """
    The recipients of an unencrypted identity file, via age-keygen -y for
    age keys and ssh-keygen -y for SSH keys; None for anything else, e.g. a
    plugin identity, or when neither tool is installed.
    """

    for tool, arguments in (("age-keygen", ["-y"]), ("ssh-keygen", ["-y", "-f"])):
        executable = shutil.which(tool)
        if executable is None:
            continue
        result = subprocess.run(
            [executable, *arguments, os.fspath(identity)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
        keys = [_recipient_key(line) for line in result.stdout.splitlines() if line.strip()]
        if result.returncode == 0 and keys:
            return keys
    return None


@cache
def _derive_recipients(identities: tuple[pathlib.Path, ...]) -> frozenset[str] | None:
    own: set[str] = set()
    for identity in identities:
        keys = _public_keys(identity)
        if keys is None:
            return None
        own.update(keys)
    return frozenset(own)


@dataclass
class RecipientScopes:
    """
    Who the files in each directory are encrypted to: the base recipients
    from resolve_recipients(), plus every nested [recipients] above the
    directory.
    """

    repository: Repository
    base: Age
    # Only recipients from .gitage have a history that shows when they changed.
    tracked: bool
    _ages: dict[pathlib.Path, Age] = field(default_factory=dict, init=False, repr=False)
    _trust_checked: bool = field(default=False, init=False, repr=False)

    def age_for(self, path: pathlib.Path) -> Age:
        directory = path.parent
        age = self._ages.get(directory)
        if age is None:
            nested = self.repository.recipient_chain(directory, include_top=False)
            extra = [recipient for rule_set in nested for recipient in rule_set.recipients or []]
            source = self.base.source
            if nested:
                top = self.repository.top_rule_file.parent
                listed = " + ".join(
                    f"{rule_set.path.relative_to(top).as_posix()} [{RECIPIENTS_SECTION}]"
                    for rule_set in nested
                )
                source = f"{self.base.target} + {listed}"
            baseline = self.repository.baseline(directory, include_top=self.tracked)
            age = self._ages[directory] = self.base.scoped(extra, source, baseline)
        return age

    def encrypted_to_user(self, path: pathlib.Path) -> bool:
        """
        Whether .gitage encrypts path to one of the user's identities. True
        when that cannot be told, e.g. for a missing or plugin identity.

        Without a base list, a file is also encrypted to the identities of
        whoever locked it. Those count as the user's, unless the user is
        listed elsewhere in the repository and so has partial access.
        """

        age = self.age_for(path)
        try:
            own = age.own_recipients()
        except RuntimeError:
            return True
        if not own:
            return True
        if not own.isdisjoint(_recipient_key(recipient) for recipient in age.recipients):
            return True
        if age.recipients and not age.to_identities:
            return False
        listed = (key for keys in self.repository.recipient_lists().values() for key in keys)
        return own.isdisjoint(listed)


RecipientLists = dict[pathlib.PurePosixPath, frozenset[str]]


def _recipient_lists(rule_sets: Iterable[RuleSet], top: pathlib.Path) -> RecipientLists:
    return {
        pathlib.PurePosixPath(rule_set.path.relative_to(top).as_posix()): frozenset(
            _recipient_key(recipient) for recipient in rule_set.recipients
        )
        for rule_set in rule_sets
        if rule_set.recipients is not None
    }


def recipient_lists_at(git: Git, rev: str) -> RecipientLists:
    """The [recipients] lists in rev; unparsable .gitage files count as without."""

    rule_sets: list[RuleSet] = []
    for path, oid in git.tree(rev).items():
        if path.name != RULE_FILE_NAME:
            continue
        try:
            rule_sets.append(parse_gitage_text(git.absolute(path), git.read_blob(oid).decode()))
        except (RuntimeError, UnicodeDecodeError):
            continue
    return _recipient_lists(rule_sets, git.root)


def trust_hash(lists: RecipientLists) -> str:
    """The SHA-256 that age.trustedRecipients pins: order and comments do not count."""

    text = "".join(
        f"{path.as_posix()}\n" + "".join(f"\t{key}\n" for key in sorted(keys))
        for path, keys in sorted(lists.items())
    )
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


class GitageCommit(NamedTuple):
    commit: str
    author: str
    email: str
    subject: str

    def __str__(self) -> str:
        return f"{self.commit[:12]} {self.author} <{self.email}>  {self.subject}"


def _gitage_commits(git: Git, revisions: list[str], *, merges: bool = True) -> list[GitageCommit]:
    """The newest commits in revisions that touch a .gitage, newest first."""

    if not git.has_commit("HEAD"):
        return []
    args = ["log", "--format=%H%x00%an%x00%ae%x00%s", f"-n{TRUST_HISTORY_LIMIT}"]
    if not merges:
        args.append("--no-merges")
    result = git.run([*args, *revisions, "--", f":(glob)**/{RULE_FILE_NAME}"])
    return [
        GitageCommit(*line.split("\0", 3))
        for line in result.stdout.decode(errors="replace").splitlines()
        if line.count("\0") >= 3
    ]


def _describe_list_changes(old: RecipientLists, new: RecipientLists) -> list[str]:
    lines: list[str] = []
    for path in sorted(old.keys() | new.keys()):
        before, after = old.get(path, frozenset()), new.get(path, frozenset())
        if before == after:
            continue
        lines.append(f"  {path}")
        lines.extend(f"    + {key}" for key in sorted(after - before))
        lines.extend(f"    - {key}" for key in sorted(before - after))
    return lines


def _describe_lists(lists: RecipientLists) -> list[str]:
    lines: list[str] = []
    for path, keys in sorted(lists.items()):
        lines.append(f"  {path}")
        lines.extend(f"    {key}" for key in sorted(keys))
    return lines or ["  (none)"]


def _pinned_trust(root: pathlib.Path) -> tuple[str, str] | None:
    """The pinned hash and where it comes from, if any."""

    value = os.environ.get(TRUSTED_RECIPIENTS_ENV, "").strip()
    if value:
        return value.lower(), TRUSTED_RECIPIENTS_ENV
    value = (_git_config_get(root, TRUSTED_RECIPIENTS_CONFIG) or "").strip()
    if value:
        return value.lower(), f"git config {TRUSTED_RECIPIENTS_CONFIG}"
    return None


def _trusted_changes(git: Git, lists: RecipientLists, pinned: str) -> list[str]:
    """
    Describe how lists differ from the pinned ones: found in the history, a
    diff and the commits since; otherwise the lists as they are.
    """

    head = recipient_lists_at(git, "HEAD") if git.has_commit("HEAD") else {}
    newer: list[GitageCommit] = []
    trusted: RecipientLists | None = head if trust_hash(head) == pinned else None
    if trusted is None:
        for commit in _gitage_commits(git, ["HEAD"]):
            candidate = recipient_lists_at(git, commit.commit)
            if trust_hash(candidate) == pinned:
                trusted = candidate
                break
            newer.append(commit)

    if trusted is None:
        return [
            f"The trusted lists are not in the last {TRUST_HISTORY_LIMIT} commits that touch "
            f"{RULE_FILE_NAME}; these are the current ones:",
            "",
            *_describe_lists(lists),
        ]

    lines = _describe_list_changes(trusted, lists)
    changed_in = [f"  {commit}" for commit in newer]
    if lists != head:
        changed_in.append("  (uncommitted changes)")
    return [*lines, "", f"Commits that touched {RULE_FILE_NAME} since:", *changed_in]


def check_recipient_trust(config: Config) -> None:
    """
    Before encrypting to .gitage's [recipients]: refuse when they differ
    from the pinned hash; without a pin, warn when someone else changed
    them last. Checks once per run.
    """

    scopes = config.scopes
    if scopes is None or scopes._trust_checked:
        return
    scopes._trust_checked = True
    git = scopes.repository.git
    if git is None:
        return

    lists = scopes.repository.recipient_lists()
    pinned = _pinned_trust(git.root)
    if pinned is not None:
        value, source = pinned
        if trust_hash(lists) == value:
            return
        _err(
            f"git-age: the [{RECIPIENTS_SECTION}] lists differ from the ones you trusted "
            f"({source}):",
            "",
            *_trusted_changes(git, lists, value),
            "",
            "Review the changes, then trust the current lists:",
            "",
            "  git-age trust",
            "",
        )
        raise RuntimeError(f"refusing to encrypt to untrusted [{RECIPIENTS_SECTION}]")

    change = _last_recipient_change(git)
    me = (_git_config_get(git.root, "user.email") or "").lower()
    if change is None or change.email.lower() == me:
        return
    _err(
        f"git-age: warning: [{RECIPIENTS_SECTION}] were last changed by someone else:",
        f"  {change}",
        "Make sure you trust that change; `git-age trust` pins the current lists, so",
        "that git-age refuses to encrypt to lists you have not seen.",
    )


def _last_recipient_change(git: Git) -> GitageCommit | None:
    """
    The newest commit that changed a [recipients] list. A merge counts only
    when its lists differ from every parent's; otherwise the change is the
    merged branch's, and its own commit counts.
    """

    hashes: dict[str, str] = {}

    def hash_at(rev: str) -> str:
        if rev not in hashes:
            lists = recipient_lists_at(git, rev) if git.has_commit(rev) else {}
            hashes[rev] = trust_hash(lists)
        return hashes[rev]

    for commit in _gitage_commits(git, ["HEAD"]):
        parents = git.run(["rev-parse", f"{commit.commit}^@"]).stdout.decode("ascii").split()
        # A root commit compares with no lists at all.
        parents = parents or [f"{commit.commit}^"]
        if all(hash_at(commit.commit) != hash_at(parent) for parent in parents):
            return commit
    return None


def warn_merged_recipient_changes(git: Git) -> None:
    """After a merge or pull: warn when it changed a [recipients] list."""

    if not git.has_commit("ORIG_HEAD") or not git.has_commit("HEAD"):
        return
    old, new = recipient_lists_at(git, "ORIG_HEAD"), recipient_lists_at(git, "HEAD")
    if old == new:
        return
    commits = _gitage_commits(git, ["ORIG_HEAD..HEAD"], merges=False)
    _err(
        f"git-age: warning: this merge changes [{RECIPIENTS_SECTION}]:",
        "",
        *_describe_list_changes(old, new),
        "",
        f"Commits that touched {RULE_FILE_NAME} since:",
        *_indented(commits),
        "",
        "Review it before you encrypt anything; `git-age trust` pins the lists you trust.",
    )


def _existing_ciphertexts(git: Git, path: pathlib.PurePosixPath) -> list[bytes]:
    """
    Return age ciphertexts Git already holds for path: index first, then HEAD.
    During a conflict the index has ours and theirs instead of stage 0.

    These are candidates for reuse so that re-locking unchanged plaintext
    produces byte-identical output instead of a fresh random encryption.
    """

    candidates: list[bytes] = []
    name = path.as_posix()
    for spec in (f":0:{name}", f":2:{name}", f":3:{name}", f"HEAD:{name}"):
        content = git.blob(spec)
        if content is None or detect_content_state(content) is not FileState.LOCKED:
            continue
        if content not in candidates:
            candidates.append(content)
    return candidates


def _combined_recipients(rule_sets: Iterable[RuleSet]) -> frozenset[str] | None:
    """Every recipient of rule_sets; None when none has a [recipients] section."""

    lists = [rule_set.recipients for rule_set in rule_sets if rule_set.recipients is not None]
    if not lists:
        return None
    return frozenset(recipient for recipients in lists for recipient in recipients)


def _recipients_at(
    git: Git, rev: str, rule_paths: list[pathlib.PurePosixPath]
) -> frozenset[str] | None:
    """
    The combined [recipients] of the .gitage files at rule_paths in rev.
    Missing and unparsable files count as having none.
    """

    rule_sets: list[RuleSet] = []
    for rule_path in rule_paths:
        content = git.blob(f"{rev}:{rule_path.as_posix()}")
        if content is None:
            continue
        try:
            rule_sets.append(parse_gitage_text(pathlib.Path(rule_path), content.decode("utf-8")))
        except (RuntimeError, UnicodeDecodeError):
            continue
    return _combined_recipients(rule_sets)


def recipients_baseline(
    repository: Repository, directory: pathlib.Path, *, include_top: bool = True
) -> Baseline | None:
    """
    Find the newest revision whose ciphertext for files in directory targets
    other recipients than now: the combined [recipients] of the .gitage files
    above it, as in the repository (staged, for one read from the index).
    With include_top false, the top-level list is left out.

    Returns None when those never changed, i.e. nothing there can be stale.
    """

    git = repository.git
    if git is None or not git.has_commit("HEAD"):
        return None
    relative = git.relative(directory)
    if relative is None:
        return None

    rule_paths = [
        pathlib.PurePosixPath(*relative.parts[:depth], RULE_FILE_NAME)
        for depth in range(len(relative.parts) + 1)
    ]
    if not include_top:
        rule_paths = rule_paths[1:]
    if not rule_paths:
        return None

    current = _combined_recipients(
        repository.recipient_chain(directory, include_top=include_top)
    )
    if _recipients_at(git, "HEAD", rule_paths) != current:
        return Baseline("HEAD", None)

    # Recipients only change in commits touching these rule files.
    result = git.run(
        [
            "--literal-pathspecs",
            "log",
            "--format=%H",
            "HEAD",
            "--",
            *(rule_path.as_posix() for rule_path in rule_paths),
        ]
    )
    for commit in os.fsdecode(result.stdout).split():
        parent = f"{commit}^"
        if not git.has_commit(parent):
            return None
        if _recipients_at(git, parent, rule_paths) != current:
            return Baseline(parent, commit)

    return None


def _ls_records(output: bytes) -> list[tuple[list[str], pathlib.PurePosixPath]]:
    """Parse `ls-tree -z` / `ls-files --stage -z` output into (fields, path)."""

    records = []
    for record in output.split(b"\0"):
        if record:
            metadata, raw_path = record.split(b"\t", 1)
            fields = metadata.decode("ascii").split(" ")
            records.append((fields, pathlib.PurePosixPath(os.fsdecode(raw_path))))
    return records


def staged_stale_files(repository: Repository) -> list[tuple[pathlib.PurePosixPath, Baseline]]:
    """
    Staged protected ciphertext still encrypted to previous recipients, each
    with the baseline it was judged by: its ciphertext is unchanged since.

    The repository comes from the index, so this uses the STAGED .gitage
    files, i.e. what the commit will contain. An uncommitted baseline means
    that this commit changes the file's recipients. Paths are relative to
    the Git root.
    """

    git = repository.git
    assert git is not None

    trees: dict[str, dict[pathlib.PurePosixPath, str]] = {}
    stale: list[tuple[pathlib.PurePosixPath, Baseline]] = []
    for entry in sorted(git.index().values()):
        if not entry.is_regular:
            continue
        relative = repository.relative(entry.path)
        if relative is None or repository.protection(relative) is None:
            continue
        baseline = repository.baseline(git.absolute(entry.path).parent)
        if baseline is None:
            continue
        if baseline.rev not in trees:
            trees[baseline.rev] = git.tree(baseline.rev)
        if trees[baseline.rev].get(entry.path) != entry.oid:
            continue
        if detect_content_state(git.read_blob(entry.oid)) is FileState.LOCKED:
            stale.append((entry.path, baseline))

    return stale


def _env_flag(name: str) -> bool:
    """A boolean environment variable such as GIT_AGE_ALLOW_EMPTY; unset is false."""

    value = os.environ.get(name)
    return value is not None and _parse_bool_env(name, value)


def _print_staged_stale(stale: list[tuple[pathlib.PurePosixPath, Baseline]]) -> None:
    changed_now = [path for path, baseline in stale if baseline.uncommitted]
    changed_before = [
        f"{path}  (changed in {baseline.changed_in[:12]})"
        for path, baseline in stale
        if baseline.changed_in is not None
    ]
    if changed_now:
        _err(
            f"git-age: this commit changes [{RECIPIENTS_SECTION}] in {RULE_FILE_NAME}, "
            "but these files are still encrypted to the previous list:",
            "",
            *_indented(changed_now),
            "",
        )
    if changed_before:
        _err(
            "git-age: warning: these files are still encrypted to a previous "
            f"[{RECIPIENTS_SECTION}] list:",
            "",
            *_indented(changed_before),
            "",
        )
    paths = [path for path, _ in stale]
    _err(
        "Re-encrypt them to the current list and stage the result:",
        "",
        "  git-age rekey",
        f"  git add -- {_shell_paths(paths)}",
        "",
    )
    if changed_now:
        _err(
            "If you really want to commit anyway, run:",
            "",
            f"  {ALLOW_STALE_RECIPIENTS_ENV}=1 git commit ...",
            "",
        )


class Skip(Exception):
    """Raised by unlock_content and rekey_content to leave a file alone, giving why."""


NO_ACCESS = "not encrypted to you"
NOT_REKEYED = "not re-encrypted to you yet"


def lock_content(config: Config, protected_file: ProtectedFile) -> bytes:
    """Return the encrypted content of an unlocked file."""

    if protected_file.state is not FileState.UNLOCKED:
        raise RuntimeError(f"cannot determine file state: {protected_file.path}")

    age = config.age_for(protected_file.path)
    age.prepare()

    plaintext = protected_file.path.read_bytes()
    return age.encrypt_reusing(protected_file.git, protected_file.git_path, plaintext)


def _decrypt_locked(config: Config, protected_file: ProtectedFile) -> bytes:
    """
    Decrypt a locked file. When that fails, raise Skip if .gitage does not
    encrypt it to the user, or if it may still be encrypted to recipients
    from before the user was added; anything else is an error.
    """

    identities = config.age.require_identities()
    path = protected_file.path
    plaintext = config.age.decrypt(path.read_bytes())
    if plaintext is not None:
        return plaintext

    if not config.encrypted_to_user(path):
        raise Skip(NO_ACCESS)
    if config.scopes is not None and config.scopes.repository.is_stale(protected_file):
        raise Skip(NOT_REKEYED)
    raise RuntimeError(f"cannot decrypt {path} with {_format_identities(identities)}")


def unlock_content(config: Config, protected_file: ProtectedFile) -> bytes:
    """Return the decrypted content of a locked file."""

    if protected_file.state is not FileState.LOCKED:
        raise RuntimeError(f"cannot determine file state: {protected_file.path}")

    return _decrypt_locked(config, protected_file)


def rekey_content(config: Config, protected_file: ProtectedFile) -> bytes:
    """Return a file freshly encrypted to the current recipients."""

    if protected_file.state is FileState.LOCKED:
        plaintext = _decrypt_locked(config, protected_file)
    elif protected_file.state is FileState.UNLOCKED:
        plaintext = protected_file.path.read_bytes()
    else:
        raise RuntimeError(f"cannot determine file state: {protected_file.path}")

    return config.age_for(protected_file.path).encrypt(plaintext)


