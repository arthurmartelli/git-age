    command: str
    root: pathlib.Path
    age: Age
    options: argparse.Namespace
    scopes: RecipientScopes | None = None

    def age_for(self, path: pathlib.Path) -> Age:
        """How to encrypt path, with the nested [recipients] above it."""

        return self.age if self.scopes is None else self.scopes.age_for(path)

