def _zsh_quote(text: str) -> str:
    return "'" + text.replace("'", "'\\''") + "'"


def _zsh_description(text: str) -> str:
    return text.replace("\\", "\\\\").replace("[", "\\[").replace("]", "\\]")


def _zsh_action(value: str | list[str]) -> str:
    if isinstance(value, list):
        return "(" + " ".join(value) + ")"
    return {"file": "_files", "dir": "_directories"}.get(value, " ")


def _zsh_arguments(command: CompletionCommand, indent: str) -> list[str]:
    specs = []
    for option in command.options:
        description = _zsh_description(option.help)
        if option.names == ["-h", "--help"]:
            exclusion = "(- *)"
        elif option.repeatable:
            exclusion = "*"
        else:
            exclusion = "(" + " ".join(option.names) + ")"
        for name in option.names:
            if option.value is None:
                specs.append(f"{exclusion}{name}[{description}]")
            else:
                suffix = "=" if name.startswith("--") else "+"
                message = option.metavar.lower().replace(":", "\\:")
                action = _zsh_action(option.value)
                specs.append(f"{exclusion}{name}{suffix}[{description}]:{message}:{action}")
    for positional in command.positionals:
        message = positional.metavar.lower()
        action = _zsh_action(positional.value)
        if positional.nargs in ("*", "+"):
            if positional.nargs == "+":
                specs.append(f":{message}:{action}")
            specs.append(f"*:{message}:{action}")
        else:
            optional = ":" if positional.nargs == "?" else ""
            specs.append(f"{optional}:{message}:{action}")
    return [f"{indent}{_zsh_quote(spec)} \\" for spec in specs]


def zsh_completion(parser: argparse.ArgumentParser) -> str:
    top, commands = completion_commands(parser)
    top = top._replace(positionals=[])
    describe = [
        f"        {_zsh_quote(command.name + ':' + command.help.replace(':', '-'))}"
        for command in commands
    ]
    cases = []
    for command in commands:
        cases.append(f"        {command.name})")
        cases.append("          _arguments -s -S \\")
        cases.extend(_zsh_arguments(command, "            "))
        cases.append("            && ret=0")
        cases.append("          ;;")
    return ZSH_COMPLETION.format(
        top="\n".join(_zsh_arguments(top, "    ")),
        describe="\n".join(describe),
        cases="\n".join(cases),
    )


