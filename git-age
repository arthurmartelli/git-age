        help="always encrypt freshly instead of reusing unchanged ciphertext from Git",
    )
    add_paths_argument(lock_parser)

    rekey_parser = subparsers.add_parser(
        "rekey", help="re-encrypt every protected file to the current recipients"
    )
    add_recipient_option(rekey_parser)
    add_identity_option(rekey_parser, "age identity used to decrypt currently locked files")
    add_paths_argument(rekey_parser)

    unlock_parser = subparsers.add_parser("unlock", help="decrypt protected working-tree files")
    add_identity_option(unlock_parser, "age identity file used for decryption")
    add_paths_argument(unlock_parser)

    edit_parser = subparsers.add_parser(
